# TTS GREETER -- Configuration
# Greets people when their computers come back online, by how long they were absent. The
# duration comes from the transition history (DatabaseService.priorStateDurationMs), so a
# quick reboot never triggers a full welcome.
# Reference: doc/automations/greeter.md
#
# Template -- copy to tts-greeter.yaml and customize for your home.

# greeting_windows are evaluated top-down; the first matching window wins, no match = silence.
# Bounds accept durations ("5s", "7m", "4h") or plain milliseconds; either bound may be omitted:
#   { gte: "4h" }             -> 4 hours or longer
#   { lte: "2m" }             -> up to 2 minutes
#   { gte: "7m", lte: "30m" } -> between 7 and 30 minutes
# Each window's "sentence" names a section of etc/i18n/<locale>/greeter.yaml.

triggers_network: [hostname1, hostname2]   # hosts to greet on return (must exist in etc/device/network.yaml)

use_ai: false                        # true -> route greetings through AI -> TTS; false -> direct TTS

# OPTIONAL -- spoken framing for every greeting, on both output paths. Name a profile from the
# active locale's tts.yaml `profiles:`; explicit tts_options fields win over the profile.
tts_profile: ''                  # empty = plain speech
#tts_options:
#  intro: 'intro-chime.wav'          # Wave filename played before the greeting
#  outro: null                       # Wave filename played after the greeting
#  intro_spacing: -1.5               # Seconds between intro end and speech start; negative = overlap

greeting_windows:                    # contiguous bands by design: every return is greeted
  - name: 'quick_reboot'             # short blip -> fun "it just rebooted!" line instead of a welcome
    absent_for: { lte: "2m" }
    sentence: 'reboot'               # greeter bundle section (per-host tts/ai templates inside)

  - name: 'short_return'             # came back quickly -> "did you forget something?"
    absent_for: { gte: "2m", lte: "1h" }
    sentence: 'forgot'

  - name: 'welcome_back'             # been gone for real -> proper welcome; open-ended above
    absent_for: { gte: "1h" }
    sentence: 'welcome'

# Optional -- suppress execution between these local times ("HHmm-HHmm"); set to null to disable.
#silence_between: "0100-0600"
