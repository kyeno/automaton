# Home Theater Automation -- one-room instance
# Presence-gated video-player dark mode for a SINGLE room: while the player answers
# HTTP (any state) the room's rollers are closed and handed back to the room's roller
# owner when it goes offline; while a video plays, interfering lights go off; on
# pause/stop/gone, light restore is delegated to the ambient-lights automation via
# invoke_automation.
# Requires video players defined under `videoPlayers` in etc/device/network.yaml.
# Reference: doc/automations/home-theater-mode.md
#
# Template -- copy to bedroom-video.yaml (one instance per room) and customize.
# "Sticky" while active: manual changes to target devices are re-corrected on the
# next tick instead of being deferred to the human-interaction cooldown.
override_human_interaction: true

# Rule "targets:" keys are zigbee2mqtt friendly names with spaces replaced by
# underscores (casing kept) -- they must exist in your setup; no separate list needed.

triggers_video:
  - laptop

triggers_network:
  - laptop

rules:
  # Rollers are owned while the player answers HTTP (any state).
  - name: 'Bedroom: player reachable - close rollers'
    conditions:
      presence: { laptop: true }
      video_player: { laptop: [playing, paused, stopped] }
    targets:
      Bedroom_Roller_Left: CLOSE

  - name: 'Bedroom: player gone - hand rollers back to their owner'
    conditions:
      presence: { laptop: false }
      video_player: { laptop: [offline] }
    invoke_automation: { name: BedroomRollersAutomation, force: true }

  # Light restore is fully delegated via `invoke_automation` to the ambient-lights
  # automation, which owns all ambient lamp devices and re-evaluates its own
  # conditions. No `presence` gate here so an offline machine also hands light control back.
  - name: 'Bedroom: not playing - delegate light restore to ambient lights'
    conditions:
      video_player: { laptop: [paused, stopped, offline] }
    invoke_automation: { name: AmbientLightsAutomation, force: true }

  - name: 'Bedroom: playing - dark mode (lights off)'
    conditions:
      presence: { laptop: true }
      video_player: { laptop: [playing] }
    targets:
      Bedroom_Plug: OFF
