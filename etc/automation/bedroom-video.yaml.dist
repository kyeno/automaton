# Home Theater Automation -- one-room instance
# Player reachable: rollers closed. Playing: interfering lights off.
# Pause/stop/gone: lights restored, room handed back to its owners.
# Requires video players under `videoPlayers` in etc/device/network.yaml.
# Reference: doc/automations/home-theater-mode.md
#
# Template -- copy to bedroom-video.yaml (one instance per room) and customize.

# Sticky: manual changes are re-corrected on the next tick
override_human_interaction: true

# Rule "targets:" keys are zigbee2mqtt friendly names, spaces replaced by underscores.

triggers_video:
  - laptop

triggers_network:
  - laptop

rules:
  # Rollers are owned while the player answers HTTP (any state).
  - name: 'Bedroom: player reachable - close rollers'
    conditions:
      presence: { laptop: true }
      video_player: { laptop: [playing, paused, stopped] }
    targets:
      Bedroom_Roller_Left: CLOSE

  - name: 'Bedroom: player gone - hand rollers back to their owner'
    conditions:
      presence: { laptop: false }
      video_player: { laptop: [offline] }
    invoke_automation: { name: BedroomRollersAutomation, force: true }

  # Light restore is delegated via `invoke_automation` to the ambient-lights automation,
  # which owns the ambient lamp devices and re-evaluates its own conditions. No `presence`
  # gate, so an offline machine also hands light control back.
  # `state_transition: { from: playing }` restricts this to real hand-offs -- playback
  # leaving playing -- and skips a player that merely came back (`offline -> stopped`).
  - name: 'Bedroom: not playing - delegate light restore to ambient lights'
    conditions:
      video_player: { laptop: [paused, stopped, offline] }
      state_transition: { 'videoPlayer:laptop': { from: playing } }
    invoke_automation: { name: AmbientLightsAutomation, force: true }

  - name: 'Bedroom: playing - dark mode (lights off)'
    conditions:
      presence: { laptop: true }
      video_player: { laptop: [playing] }
    targets:
      Bedroom_Plug: OFF
