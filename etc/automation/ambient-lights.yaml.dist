# Ambient Lights Automation Configuration
# Morning: turns off leftover lights once natural light becomes sufficient.
# Evening: turns on ambient lamps (socket-powered) once dusk settles.
# Each rule acts at most once per day ("once: true"), then stands down until
# the next window opens -- humans keep full control of the lights in between.
#
# Copy this file to "ambient-lights.yaml" and customize device names/thresholds.

# Device friendly names must exist in your zigbee2mqtt setup. Rule "targets:"
# keys are these same names with spaces replaced by underscores (casing kept).
targets:
  # --- Ambient lamps (sockets) -- morning OFF + evening ON ---
  - 'Kitchen Outlet'
  - 'Hallway Outlet'
  # --- Wall switches driving main room lights -- morning OFF only ---
  - 'Living Room Switch'

sensors:
  illuminance: 'Outdoor Luminance'

triggers_zigbee:
  - 'Outdoor Luminance'

timer_interval: "30s"

rules:
  - name: 'Bright morning - turn off leftover lights'
    once: true
    conditions:
      time-of-day: [morning]
      illuminance: { gte: 20 }
    targets:
      Kitchen_Outlet: OFF
      Hallway_Outlet: OFF
      Living_Room_Switch: OFF

  - name: 'Settled dusk - turn on ambient lamps'
    once: true
    conditions:
      time-of-day: [evening]
      illuminance: { lt: 900 }
    targets:
      Kitchen_Outlet: ON
      Hallway_Outlet: ON
