# Ambient Lights Automation Configuration
# Morning: turns off leftover lights once natural light becomes sufficient.
# Dusk: turns on ambient lamps (socket-powered) once it gets dark enough.
# Each autonomous rule acts at most once per calendar day PER TIME WINDOW ("once: true").
# Reference: doc/automations/ambient-lights.md
# Template -- copy to ambient-lights.yaml and customize device names/thresholds.

# Rule "targets:" keys are zigbee2mqtt friendly names with spaces replaced by
# underscores (casing kept) -- they must exist in your setup; no separate list needed.

sensors:
  illuminance: 'Outdoor Luminance'

triggers_zigbee:
  - 'Outdoor Luminance'

# Presence transitions of these hosts wake this automation under trigger_on_change_only.
triggers_network: [my-pc, laptop]

timer_interval: "30s"

# Re-evaluate only on real sensor/player/presence transitions, not on every interval tick.
trigger_on_change_only: true

# Stand-down guard: while a listed player is in a listed status, Home Theater Mode owns
# the lights. Hosts combine with OR; statuses: playing, paused, stopped, offline.
video_player_suppression:
  my-pc: [playing]
  laptop: [playing]

rules:
  # Morning lights-off, gated on civil dawn ("sunrise" resolves to civil twilight).
  - name: 'Bright morning - turn off leftover lights'
    once: true
    conditions:
      time_of_day: [morning]
      hour: { gte: sunrise }
      illuminance: { gte: 20 }
    targets:
      Kitchen_Outlet: OFF
      Hallway_Outlet: OFF
      Living_Room_Switch: OFF

  # Dark-window rule: fires once per window when it gets dark enough. Two independent windows,
  # each with its own `once:` slot (the budget splitter reads `time_of_day` gates at any depth):
  # an unguarded `evening` arm, and an `afternoon` arm gated on civil dusk
  # (`hour: { gte: sunset }`) because in winter dusk lands inside `afternoon`. The sun gate is
  # what keeps a gloomy mid-afternoon (illuminance below threshold) from lighting the lamps
  # hours before dusk -- the periods are fixed clock bands with no sun awareness of their own.
  - name: 'Settled dusk - turn on ambient lamps'
    once: true
    # Re-assert at this one daily transition: paired lamps must flip together even when a cached
    # state is stale -- an earlier unconfirmed command can leave it describing the pre-command
    # world, and no-op suppression would then desync the pair (doc/BUGS.md issue 3).
    reassert_state: true
    conditions:
      illuminance: { lt: 900 }
      any_of:
        - time_of_day: [evening]
        - all_of:
            - time_of_day: [afternoon]
            - hour: { gte: sunset }   # winter dusk lands inside `afternoon`
    targets:
      Kitchen_Outlet: ON
      Hallway_Outlet: ON

  # Pre-dawn restore: answers a home-theater player-gone hand-off (a forced poke, which
  # consumes no budget) and nothing else. `forced_only` keeps natural timer/sensor ticks out of
  # the dark morning entirely -- a movie that ends at 05:00 gets these lamps back, a 00:26
  # presence blip in the middle of a session does not. The period list stops at 04:59 while
  # civil dawn moves with the season (03:09 in June, 07:45 in December), so
  # `hour: { lt: sunrise }` covers midnight -> dawn, which no day-period list can express (a
  # single `hour:` bound cannot wrap midnight).
  # Keep this rule to the lamps it owns. Any target a presence-gated rule owns (a room light
  # that should only burn when someone is in it) does NOT belong here: the same hand-off poke
  # re-evaluates that rule as well, so an occupant gets the light back at its own level and an
  # empty house stays dark.
  - name: 'Pre-dawn restore - turn on ambient lamps'
    forced_only: true
    conditions:
      time_of_day: [night, morning]
      hour: { lt: sunrise }    # midnight -> civil dawn (the "dark morning")
      illuminance: { lt: 900 }
    targets:
      Kitchen_Outlet: ON
      Hallway_Outlet: ON
