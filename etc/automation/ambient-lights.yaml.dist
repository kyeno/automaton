# Ambient Lights Automation Configuration
# Morning: turns off leftover lights once natural light becomes sufficient.
# Evening: turns on ambient lamps (socket-powered) once dusk settles.
# Each rule acts at most once per day ("once: true"), then stands down until
# the next window opens -- humans keep full control of the lights in between.
#
# Copy this file to "ambient-lights.yaml" and customize device names/ids.

targets:
  # --- Ambient lamps (sockets) -- morning OFF + evening ON ---
  - name: 'Kitchen Outlet'
    id: kitchen_outlet
  - name: 'Hallway Outlet'
    id: hallway_outlet
  # --- Wall switches driving main room lights -- morning OFF only ---
  - name: 'Living Room Switch'
    id: living_switch

sensors:
  illuminance: 'Outdoor Luminance'

triggers_zigbee:
  - 'Outdoor Luminance'

timer_interval_ms: 30000

rules:
  - name: 'Bright morning - turn off leftover lights'
    once: true
    conditions:
      time-of-day: [morning]
      illuminance: { gte: 20 }
    targets:
      kitchen_outlet: OFF
      hallway_outlet: OFF
      living_switch: OFF

  - name: 'Settled dusk - turn on ambient lamps'
    once: true
    conditions:
      time-of-day: [evening]
      illuminance: { lt: 2000 }   # Placeholder -- tune by observing the sensor at dusk
    targets:
      kitchen_outlet: ON
      hallway_outlet: ON
