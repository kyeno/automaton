# Ambient Lights Automation Configuration
# Morning: turns off leftover lights once natural light becomes sufficient.
# Dusk: turns on ambient lamps (socket-powered) once it gets dark enough.
# Each autonomous rule acts at most once per calendar day PER TIME WINDOW ("once: true").
# Reference: doc/automations/ambient-lights.md
# Template -- copy to ambient-lights.yaml and customize device names/thresholds.

# Rule "targets:" keys are zigbee2mqtt friendly names, spaces replaced by underscores.

sensors:
  illuminance: 'Outdoor Luminance'

triggers_zigbee:
  - 'Outdoor Luminance'

# Hosts whose presence transitions wake this automation
triggers_network: [my-pc, laptop]

timer_interval: "30s"

# React to transitions only, not to every tick
trigger_on_change_only: true

# Stand-down guard: these players own the lights while in these statuses
video_player_suppression:
  my-pc: [playing]
  laptop: [playing]

rules:
  # Morning lights-off, after civil dawn
  - name: 'Bright morning - turn off leftover lights'
    once: true
    conditions:
      time_of_day: [morning]
      hour: { gte: sunrise }
      illuminance: { gte: 20 }
    targets:
      Kitchen_Outlet: OFF
      Hallway_Outlet: OFF
      Hallway_Cupboard_Outlet: OFF    # safety net: cupboard lamp never survives into daylight
      Living_Room_Switch: OFF

  # Dusk lamps-on: once per window when dark, never before `predusk`
  - name: 'Settled dusk - turn on ambient lamps'
    once: true
    reassert_state: true    # re-send even when cached state matches
    conditions:
      time_of_day: [afternoon, evening]
      hour: { gte: predusk }   # sunset minus 30 min
      illuminance: { lt: 900 }
    targets:
      Kitchen_Outlet: ON
      Hallway_Outlet: ON
      Hallway_Cupboard_Outlet: ON

  # Cupboard lamp out for the night
  - name: 'Past midnight - turn off hallway cupboard lamp'
    once: true
    conditions:
      time_of_day: [night]    # 00:00-04:59
    targets:
      Hallway_Cupboard_Outlet: OFF

  # Pre-dawn restore: forced runs only (home-theater hand-off); socket lamps only
  - name: 'Pre-dawn restore - turn on ambient lamps'
    forced_only: true
    conditions:
      time_of_day: [night, morning]
      hour: { lt: sunrise }    # midnight -> civil dawn
      illuminance: { lt: 900 }
    targets:
      Kitchen_Outlet: ON
      Hallway_Outlet: ON
