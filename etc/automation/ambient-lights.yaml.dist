# Ambient Lights Automation Configuration
# Morning: turns off leftover lights once natural light becomes sufficient.
# Evening/night: turns on ambient lamps (socket-powered) once it gets dark enough.
# Each rule acts at most once per day ("once: true"), then stands down until
# the next window opens -- humans keep full control of the lights in between.
#
# Copy this file to "ambient-lights.yaml" and customize device names/thresholds.

# Rule "targets:" keys are your zigbee2mqtt device names with spaces replaced by
# underscores (casing kept) -- they must exist in your setup; no separate list needed.

sensors:
  illuminance: 'Outdoor Luminance'

triggers_zigbee:
  - 'Outdoor Luminance'

timer_interval: "30s"

# Stand-down guard: while either player is actively playing, Home Theater Mode owns
# the lights and we stand down so we do not fight it over the same devices. Replace
# these host names with your own video-player host names from network.yaml.
video_player_suppression:
  my-pc: [playing]
  laptop: [playing]

rules:
  - name: 'Bright morning - turn off leftover lights'
    once: true
    conditions:
      time-of-day: [morning]
      illuminance: { gte: 20 }
    targets:
      Kitchen_Outlet: OFF
      Hallway_Outlet: OFF
      Living_Room_Switch: OFF

  - name: 'Settled dusk / night - turn on ambient lamps'
    once: true
    conditions:
      time-of-day: [evening, night]
      illuminance: { lt: 900 }
    targets:
      Kitchen_Outlet: ON
      Hallway_Outlet: ON
