# Ambient Lights Automation Configuration
# Morning: turns off leftover lights once natural light becomes sufficient.
# Evening: turns on ambient lamps (socket-powered) once dusk settles.
# Each autonomous rule acts at most once per calendar day PER TIME WINDOW ("once: true"),
# so an early firing never eats the budget of a later darkness window on the same day.
# Humans keep full control within a window after it fires.
# Late night (pre-dawn): the restore rule is invoke-only (forced_only) -- it answers forced
# delegations (e.g., a home-theater pause hand-off for late-night movies) but never fires
# on its own, so no unannounced midnight lights-on.
#
# Copy this file to "ambient-lights.yaml" and customize device names/thresholds.

# Rule "targets:" keys are your zigbee2mqtt device names with spaces replaced by
# underscores (casing kept) -- they must exist in your setup; no separate list needed.

sensors:
  illuminance: 'Outdoor Luminance'

triggers_zigbee:
  - 'Outdoor Luminance'

timer_interval: "30s"

# Stand-down guard: while either player is actively playing, Home Theater Mode owns
# the lights and we stand down so we do not fight it over the same devices. Replace
# these host names with your own video-player host names from network.yaml.
video_player_suppression:
  my-pc: [playing]
  laptop: [playing]

rules:
  - name: 'Bright morning - turn off leftover lights'
    once: true
    conditions:
      time-of-day: [morning]
      illuminance: { gte: 20 }
    targets:
      Kitchen_Outlet: OFF
      Hallway_Outlet: OFF
      Living_Room_Switch: OFF

  - name: 'Settled dusk - turn on ambient lamps'
    once: true
    conditions:
      time-of-day: [evening]
      illuminance: { lt: 900 }
    targets:
      Kitchen_Outlet: ON
      Hallway_Outlet: ON

  # Invoke-only (forced_only): acts solely when another automation delegates to this one
  # with force: true -- e.g., restoring these lamps after a late-night movie is paused.
  # Natural timer/sensor ticks skip it entirely, so pre-dawn darkness alone never switches
  # anything on. Remove the flag if you DO want autonomous pre-dawn lighting too.
  - name: 'Late-night restore - turn on ambient lamps'
    forced_only: true
    conditions:
      time-of-day: [night]
      illuminance: { lt: 900 }
    targets:
      Kitchen_Outlet: ON
      Hallway_Outlet: ON
