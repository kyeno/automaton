# Ambient Lights Automation Configuration
# Morning: turns off leftover lights once natural light becomes sufficient.
# Dusk: turns on ambient lamps (socket-powered) once it gets dark enough -- the
# "Settled dusk" rule covers the evening/night windows and both fires autonomously
# and answers a home-theater player-gone hand-off (a forced poke re-evaluates it
# without consuming its once-per-day budget).
# Each autonomous rule acts at most once per calendar day PER TIME WINDOW ("once: true"),
# so an early firing never eats the budget of a later darkness window on the same day.
# Humans keep full control within a window after it fires.
#
# Copy this file to "ambient-lights.yaml" and customize device names/thresholds.

# Rule "targets:" keys are your zigbee2mqtt device names with spaces replaced by
# underscores (casing kept) -- they must exist in your setup; no separate list needed.

sensors:
  illuminance: 'Outdoor Luminance'

triggers_zigbee:
  - 'Outdoor Luminance'

timer_interval: "30s"

# Only re-evaluate on real sensor/player/presence transitions, not every interval tick:
# prevents stale conditions from re-asserting light states on idle intervals.
trigger_on_change_only: true

# Stand-down guard: while either player is actively playing, Home Theater Mode owns
# the lights and we stand down so we do not fight it over the same devices. Replace
# these host names with your own video-player host names from network.yaml.
video_player_suppression:
  my-pc: [playing]
  laptop: [playing]

rules:
  - name: 'Bright morning - turn off leftover lights'
    once: true
    conditions:
      time-of-day: [morning]
      illuminance: { gte: 20 }
    targets:
      Kitchen_Outlet: OFF
      Hallway_Outlet: OFF
      Living_Room_Switch: OFF

  # Covers every dark window (evening/night) in one rule: fires autonomously once per window
  # when it gets dark enough, AND answers a home-theater player-gone hand-off -- a forced
  # poke re-evaluates it without consuming the once-per-day budget, so a movie that ends
  # past midnight still gets these lamps back while pre-dawn ticks never fire uninvited.
  - name: 'Settled dusk - turn on ambient lamps'
    once: true
    conditions:
      time-of-day: [evening, night]
      illuminance: { lt: 900 }
    targets:
      Kitchen_Outlet: ON
      Hallway_Outlet: ON
