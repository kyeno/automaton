# TTS TWILIGHT -- Configuration
# Announces civil dawn and civil dusk by voice: one announcement per event per day, fired at
# the exact local minute the event happens.
#   * the minute-granularity tick is anchored to wall-clock minutes, so a tick lands in the
#     minute the event falls in;
#   * an event is announced only while fresh -- its instant within announce_grace of now --
#     so a machine asleep over dawn announces it late, never yesterday's dawn;
#   * `once: true` uses the rule engine's daily Redis marker, surviving restarts.
# Manual runs ("/automation run|force TtsTwilightAutomation") preview the next event and do
# not consume its daily slot.
#
# Each rule speaks its own section of etc/i18n/<locale>/twilight.yaml and carries its own
# framing keys, so dawn and dusk get different jingles:
#   tts_profile:  a `profiles:` entry of the active locale's tts.yaml
#   tts_options:  explicit framing; wins over the profile field by field
# Placeholders, all from the EVENT instant: {% time %} -- local "HH:MM";
# {% time_of_day %} -- day-period word from date.yaml; {% hours %} / {% minutes %} -- the
# same moment in the locale's clock parts, used by the ai lines to voice the hour in words.
#
# Output routing: use_ai false -> speak the section's tts line directly; use_ai true -> send
# the section's ai instruction to the model (empty reply / error / AI down -> warn log + tts).
# Reference: doc/automations/twilight.md
#
# Template -- copy to tts-twilight.yaml and customize for your home.
# Civil dawn/dusk come from locale.geo_latitude / locale.geo_longitude in etc/automaton.yaml;
# with no usable coordinates the automation stays quiet and warns once a day.

use_ai: false                      # true -> route announcements through AI -> TTS; false -> direct TTS

timer_interval: "1m"               # tick driving the announcements -- keep at minute granularity
announce_grace: "5m"               # announce an event this long after its instant (catch-up window)
silence_between: null              # "HHmm-HHmm" local window to stay quiet; null = announce at any hour

rules:                             # dawn first, dusk second -- first announceable rule wins per tick
  - name: 'Civil dawn'
    event: 'sundawn'               # civil dawn instant computed from locale.geo_* (alias: sunrise)
    conditions: { hour: { gte: 'sundawn', lt: 'sundusk' } }   # gate: the dawn-to-dusk window
    sentence: 'twilight.sundawn'
    once: true                     # one announcement per day (the rule engine's Redis marker)
    #tts_profile: 'sundawn'        # name a profiles: entry of the active locale's tts.yaml to add a jingle
    #tts_options:
    #  intro: 'intro-chime.wav'    # Wave filename played before the announcement
    #  intro_spacing: -1.5         # Seconds between intro end and speech start; negative = overlap

  - name: 'Civil dusk'
    event: 'sundusk'               # civil dusk instant computed from locale.geo_* (alias: sunset)
    conditions: { hour: { gte: 'sundusk' } }   # gate: from dusk on, the dawn window is closed
    sentence: 'twilight.sundusk'
    once: true                     # one announcement per day (the rule engine's Redis marker)
    #tts_profile: 'sundusk'        # name a profiles: entry of the active locale's tts.yaml to add a jingle
    #tts_options:
    #  intro: 'intro-chime.wav'    # Wave filename played before the announcement
    #  intro_spacing: -1.5         # Seconds between intro end and speech start; negative = overlap
