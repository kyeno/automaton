# TTS GARDENER -- Configuration
# Voice reports on plant soil moisture, chosen from the moisture bands in `rules:` below.
# Two entry points:
#   reactive  -- any change on a listed flower sensor is evaluated; it speaks only when a
#                plant worsened past its last announced band and the worst one reached a
#                band marked `reactive: true`. Recovery lowers the baseline silently.
#                Throttled by event_cooldown; announce_times does not apply to these.
#   scheduled -- a full status report at each announce_times slot, once per day.
# Manual runs ("/automation run|force TtsGardenerAutomation") always speak immediately.
#
# Sensor health is monitored independently by alerts.frozen_sensors in automaton.yaml.
#
# Output routing: use_ai false -> speak the band's tts line directly; use_ai true -> send the
# band's ai instruction to the model (empty reply / error / AI down -> warn log + tts line).
#
# rules are evaluated top-down per plant; first matching band wins. Each "sentence" names a
# section of etc/i18n/<locale>/gardener.yaml, with runtime placeholders:
#   {% affected_flowers %} -- every plant below the healthy band as "Name (NN%)", driest first
#   {% driest_flower %}    -- the single driest plant
#   {% driest_moisture %}  -- that plant's moisture as a percentage ("21%")
# Reference: doc/automations/gardener.md

triggers_zigbee: [Flower Sensor One, Flower Sensor Two]   # replace with your soil sensor names

moisture_property: 'soil_moisture'    # state key carrying the percent value on those devices (z2m exposure-dependent)

use_ai: false                     # true -> route announcements through AI -> TTS; false -> direct TTS

# Spoken framing for every report, on both output paths. The profile names an entry of the
# active locale's tts.yaml `profiles:`; explicit tts_options entries win field by field.
tts_profile: ''                 # empty = plain speech; optionally name a locale TTS profile
#tts_options:
#  intro: 'intro-chime.wav'      # Wave filename played before the report
#  outro: null                   # Wave filename played after the report
#  intro_spacing: -1.5           # Seconds between intro end and speech start; negative = overlap

announce_times: ["0830", "1900"] # local HHmm slots for the twice-daily status report (each fires once per day)
timer_interval: "1m"            # tick driving announce_times scheduling -- keep at minute granularity
silence_between: "2300-0600"    # suppress execution between these local times ("HHmm-HHmm"); set null to disable
event_cooldown: "5m"            # minimum gap between two event-driven reports, garden-wide ("5m", "300s", plain ms); 0 disables

rules:                          # most severe first -- first matching band wins per plant
                                # reactive: true  -> a drop into this band may speak on its own
                                # reactive: false -> this band is reported by the slots only
  - name: 'Critical drought'
    conditions: { moisture: { lte: 20 } }
    sentence: 'gardener.critical'
    reactive: true

  - name: 'Needs watering'
    conditions: { moisture: { lte: 35 } }
    sentence: 'gardener.dry'
    reactive: true

  - name: 'Getting dry'
    conditions: { moisture: { lte: 50 } }
    sentence: 'gardener.slightly_dry'
    reactive: false

  - name: 'Healthy'
    conditions: { moisture: { gt: 50 } }
    sentence: 'gardener.healthy'
    reactive: false
