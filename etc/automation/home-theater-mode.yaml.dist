# Presence-gated video-player automation (distribution template).
#
# While a player answers HTTP (any state -- playing, paused or stopped), the
# room's rollers are closed; when the player is gone (machine off or player
# closed), they are handed back to their default automations. When a video is
# actively playing, interfering lights are switched off (dark mode); on
# pause/stop/gone light restore is delegated to the ambient-lights
# automation via invoke_automation, which owns those lamps and decides itself.
#
# Requires video players defined under `videoPlayers` in etc/device/network.yaml
# (see the MPC-HC / VLC setup notes there).
#
# The automation opts into `override_human_interaction` so it is "sticky" while
# active: manual changes to its target devices are re-corrected on the next tick
# rather than being deferred to a human-interaction cooldown.

override_human_interaction: true

# Light restore is fully delegated via `invoke_automation` to the ambient-lights
# automation, which owns all ambient lamp devices and re-evaluates its own conditions.

targets:
  # Replace with your own Zigbee device names (must exist in zigbee.yaml).
  # Rule "targets:" keys are these same names with spaces replaced by underscores.
  # --- Living room -- interfering lights / rollers ---
  - 'Living Room Plug'
  - 'Living Room Roller Left'
  # --- Bedroom -- lights / rollers ---
  - 'Bedroom Plug'
  - 'Bedroom Roller Left'

# Player host names as configured under `videoPlayers` in network.yaml.
triggers_video:
  - my-pc
  - laptop

triggers_network:
  - my-pc
  - laptop


rules:
  # ===========================================================================
  # Living room -- all four rules grouped together
  # ===========================================================================
  # Rollers are owned while the player answers HTTP (any state); handed back to the
  # room's own roller automation when it goes offline so that owner decides the
  # post-playback position from its full rule set. `invoke_automation` runs the named
  # automation now -- replace placeholder names with your installed automations.
  # `force: true` makes them act even if a once/silent guard would otherwise block
  # (human cooldowns still apply).
  - name: 'Living room: player reachable - close rollers'
    conditions:
      presence: { my-pc: true }
      video-player: { my-pc: [playing, paused, stopped] }
    targets:
      Living_Room_Roller_Left: CLOSE

  - name: 'Living room: player gone - hand rollers back to their owner'
    conditions:
      presence: { my-pc: false }
      video-player: { my-pc: [unknown, unreachable] }
    invoke_automation: { name: LivingRoomRollersAutomation, force: true }

  # Light restore is fully delegated via `invoke_automation` to the ambient-lights
  # automation, which owns all ambient lamp devices and re-evaluates its own
  # conditions. No `presence` gate here so an offline machine also hands light control back.
  - name: 'Living room: not playing - delegate light restore to ambient lights'
    conditions:
      video-player: { my-pc: [paused, stopped, unreachable, unknown] }
    invoke_automation: { name: AmbientLightsAutomation, force: true }

  - name: 'Living room: playing - dark mode (lights off)'
    conditions:
      presence: { my-pc: true }
      video-player: { my-pc: [playing] }
    targets:
      Living_Room_Plug: OFF

  # ===========================================================================
  # Bedroom -- all four rules grouped together
  # ===========================================================================
  - name: 'Bedroom: player reachable - close rollers'
    conditions:
      presence: { laptop: true }
      video-player: { laptop: [playing, paused, stopped] }
    targets:
      Bedroom_Roller_Left: CLOSE

  - name: 'Bedroom: player gone - hand rollers back to their owner'
    conditions:
      presence: { laptop: false }
      video-player: { laptop: [unknown, unreachable] }
    invoke_automation: { name: BedroomRollersAutomation, force: true }

  - name: 'Bedroom: not playing - delegate light restore to ambient lights'
    conditions:
      video-player: { laptop: [paused, stopped, unreachable, unknown] }
    invoke_automation: { name: AmbientLightsAutomation, force: true }

  - name: 'Bedroom: playing - dark mode (lights off)'
    conditions:
      presence: { laptop: true }
      video-player: { laptop: [playing] }
    targets:
      Bedroom_Plug: OFF
