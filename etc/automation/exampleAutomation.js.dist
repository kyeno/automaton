/**
 * Example Automation -- Rule-based blinds controller.
 * Copy this file to a .js name (e.g., "my-blinds-automation.js"), rename the
 * class, update CONFIG_PATH to point at your YAML config, and customize logic.
 *
 * @author Ratan M. Kyeno
 * @license MIT
 */
'use strict'

import path from 'node:path'
import { fileURLToPath } from 'node:url'

import RuleBasedAutomationBase from '../../src/automation/base/ruleBasedAutomationBase.js'

// ---------------------------------------------------------------------------
// Constants
// ---------------------------------------------------------------------------

// Point this at your companion YAML config (same directory as this script)
const CONFIG_PATH = path.join(
    path.dirname(fileURLToPath(import.meta.url)),
    'example-automation.yaml'   // <-- rename to match your yaml file
)

// ---------------------------------------------------------------------------
// Class
// ---------------------------------------------------------------------------

export default class ExampleBlindsAutomation extends RuleBasedAutomationBase {

    /** Create the example blinds automation from its YAML configuration. */
    constructor() {
        super({ name: 'ExampleBlindsAutomation', configPath: CONFIG_PATH })
    }

    /** Initialize the rule engine and its subscriptions. */
    async init() {
        await super.init()
    }

    /**
     * Resolve which command to send for a given target device.
     * Delegate to blinds-specific resolve in base class.
     * @param {object} device - Target device
     * @param {string} targetId - Rule target key
     * @param {object[]} matchingRules - Rules whose conditions matched
     * @returns {object|null} Resolved command, or null
     */
    resolveCommand(device, targetId, matchingRules) {
        return this.blindsResolveCommand(device, targetId, matchingRules)
    }
}