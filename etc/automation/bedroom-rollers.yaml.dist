# Bedroom Roller Shutter Automation Configuration
# Controls multiple roller shutters in a bedroom based on outdoor conditions.
# Reference: doc/automations/bedroom-rollers.md
# Template -- copy to bedroom-rollers.yaml (or your own name) and customize.

# Rule "targets:" keys are zigbee2mqtt friendly names with spaces replaced by
# underscores (casing kept) -- they must exist in your setup; no separate list needed.

sensors:
  illuminance: 'Outdoor Luminance'
  temperature: 'Outdoor Temperature'

triggers_zigbee:
  - 'Outdoor Luminance'
  - 'Outdoor Temperature'

timer_interval: "1m"

# Stand-down guard: while a listed player is in a listed status, the whole automation
# stands down. Hosts combine with OR; statuses: playing, paused, stopped, offline.
video_player_suppression:
  laptop: [playing, paused, stopped]

rules:
  - name: 'Night - close all'
    conditions:
      time_of_day: [evening, night]
      illuminance: { lt: 15 }
    targets:
      Bedroom_Roller_Left: CLOSE
      Bedroom_Roller_Right: CLOSE
