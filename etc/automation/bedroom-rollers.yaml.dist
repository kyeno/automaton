# Bedroom Roller Shutter Automation Configuration
# Controls multiple roller shutters in a bedroom based on outdoor conditions.
#
# Copy this file to "bedroom-rollers.yaml" (or your own name) and customize.

# Rule "targets:" keys are your zigbee2mqtt device names with spaces replaced by
# underscores (casing kept) -- they must exist in your setup; no separate list needed.

sensors:
  illuminance: 'Outdoor Luminance'
  temperature: 'Outdoor Temperature'

triggers_zigbee:
  - 'Outdoor Luminance'
  - 'Outdoor Temperature'

timer_interval: "1m"

# Optional stand-down guard: while any listed player is in one of the listed
# statuses, the whole automation stands down (e.g., so it does not fight a
# home-theater automation over the same rollers). Hosts combine with OR;
# statuses: playing, paused, stopped, unreachable, unknown.
video_player_suppression:
  my-pc: [playing, paused, stopped]

rules:
  - name: 'Night - close all'
    conditions:
      time-of-day: [evening, night]
      illuminance: { lt: 15 }
    targets:
      Bedroom_Roller_Left: CLOSE
      Bedroom_Roller_Right: CLOSE
