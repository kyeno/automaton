# Home Theater Automation -- one-room instance
# Presence-gated video-player dark mode for a SINGLE room: while the player answers
# HTTP (any state) the room's rollers are closed and handed back to the room's roller
# owner when it goes offline; while a video plays, interfering lights go off; on
# pause/stop/gone, light restore is delegated to the ambient-lights automation via
# invoke_automation.
# Requires video players defined under `videoPlayers` in etc/device/network.yaml.
# Reference: doc/automations/home-theater-mode.md
#
# Template -- copy to home-office-video.yaml (one instance per room) and customize.

# "Sticky" while active: manual changes to target devices are re-corrected on the
# next tick instead of being deferred to the human-interaction cooldown.
override_human_interaction: true

# Timer is a safety net only: ticks are skipped unless a monitored state
# (video-player status, network presence) transitioned since the last evaluation.
trigger_on_change_only: true

# Context source of truth for the restore rule's illuminance gate -- NOT a trigger.
sensors:
  illuminance: 'Outdoor Luminance'

timer_interval: "15m"

# Rule "targets:" keys are zigbee2mqtt friendly names with spaces replaced by
# underscores (casing kept) -- they must exist in your setup; no separate list needed.

triggers_video:
  - my-pc

triggers_network:
  - my-pc

rules:
  # Rollers are owned while the player answers HTTP (any state).
  - name: 'Office: player reachable - close rollers'
    conditions:
      presence: { my-pc: true }
      video_player: { my-pc: [playing, paused, stopped] }
    targets:
      Living_Room_Roller_Left: CLOSE

  # Player gone: hand the room back to its owners. The array form of
  # `invoke_automation` force-fires both the roller owner and the ambient-lights
  # owner; `offline` covers an unresponsive player and a powered-down host.
  - name: 'Office: player gone - hand back to the room owners'
    conditions:
      video_player: { my-pc: [offline] }
    invoke_automation:
      - { name: HomeOfficeRollersAutomation, force: true }
      - { name: AmbientLightsAutomation, force: true }

  # Light restore for an ONLINE player that has paused or stopped, gated by time of
  # day + outdoor illuminance. Dimmers take `{state: 'ON', brightness: { l1: 50, l2: 25 }}`:
  # a bare `{brightness: N}` sets the level without switching the relay on.
  - name: 'Office: paused/stopped - restore ambient lighting'
    conditions:
      video_player: { my-pc: [paused, stopped] }
      time_of_day: [afternoon, evening, night]
      illuminance: { lt: 900 }
    targets:
      Living_Room_Plug: ON
      Kitchen_Plug: ON
      Living_Room_Dimmer: { state: 'ON', brightness: { l1: 50, l2: 25 } }

  - name: 'Office: playing - dark mode (lights off)'
    conditions:
      presence: { my-pc: true }
      video_player: { my-pc: [playing] }
    targets:
      Living_Room_Plug: OFF
      Kitchen_Plug: OFF
      Living_Room_Dimmer: OFF
