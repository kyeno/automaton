# Home Theater Automation -- one-room instance
# Player reachable: rollers closed. Playing: interfering lights off.
# Pause/stop/gone: lights restored, room handed back to its owners.
# Requires video players under `videoPlayers` in etc/device/network.yaml.
# Reference: doc/automations/home-theater-mode.md
#
# Template -- copy to home-office-video.yaml (one instance per room) and customize.

# Sticky: manual changes are re-corrected on the next tick
override_human_interaction: true

# Ticks only on monitored state transitions
trigger_on_change_only: true

# Context for the restore rule's illuminance gate -- NOT a trigger
sensors:
  illuminance: 'Outdoor Luminance'

timer_interval: "15m"

# Rule "targets:" keys are zigbee2mqtt friendly names, spaces replaced by underscores.

triggers_video:
  - my-pc

triggers_network:
  - my-pc

rules:
  # Rollers are owned while the player answers HTTP (any state).
  - name: 'Office: player reachable - close rollers'
    conditions:
      presence: { my-pc: true }
      video_player: { my-pc: [playing, paused, stopped] }
    targets:
      Living_Room_Roller_Left: CLOSE

  # Player gone: force-fire the roller owner and the ambient-lights owner
  - name: 'Office: player gone - hand back to the room owners'
    conditions:
      video_player: { my-pc: [offline] }
    invoke_automation:
      - { name: HomeOfficeRollersAutomation, force: true }
      - { name: AmbientLightsAutomation, force: true }

  # Restore ambient lighting on a paused/stopped player, while dark. The night window is an
  # explicit OR -- a single `hour:` bound cannot wrap midnight.
  # `state_transition: { from: playing }` pins the origin of the transition, so a player
  # that merely came back (`offline -> stopped`) is not read as a pause.
  - name: 'Office: paused/stopped - restore ambient lighting'
    reassert_state: true    # re-send even when cached state matches
    conditions:
      video_player: { my-pc: [paused, stopped] }
      state_transition: { 'videoPlayer:my-pc': { from: playing } }
      illuminance: { lt: 900 }
      any_of:
        - hour: { gte: sunset }    # sunset -> midnight
        - hour: { lt: sunrise }    # midnight -> civil dawn (the "dark morning")
    targets:
      Living_Room_Plug: ON
      Kitchen_Plug: ON
      Living_Room_Dimmer: { state: 'ON', brightness: { l1: 50, l2: 25 } }

  # One lamp on its own terms: same gates as the restore rule, narrowed to the evening
  # half of the night -- `hour: { gte: sunset }` ends at midnight, so no upper bound needed.
  - name: 'Office: paused/stopped before midnight - hallway cupboard lamp'
    reassert_state: true
    conditions:
      video_player: { my-pc: [paused, stopped] }
      state_transition: { 'videoPlayer:my-pc': { from: playing } }
      illuminance: { lt: 900 }
      hour: { gte: sunset }    # sunset -> midnight; the axis ceiling is midnight
    targets:
      Hallway_Cupboard_Outlet: ON

  - name: 'Office: playing - dark mode (lights off)'
    conditions:
      presence: { my-pc: true }
      video_player: { my-pc: [playing] }
    targets:
      Living_Room_Plug: OFF
      Kitchen_Plug: OFF
      Hallway_Cupboard_Outlet: OFF
      Living_Room_Dimmer: OFF
