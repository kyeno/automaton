# Home Theater Automation -- one-room instance (distribution template).
#
# Presence-gated video-player dark mode for a SINGLE room: while the player
# answers HTTP (any state) the room's rollers are closed and handed back to the
# room's roller owner when it goes offline; while a video plays, interfering
# lights go off (dark mode); on pause/stop/gone this instance restores its lamp
# set locally from time-of-day + illuminance rules instead of delegating to the
# ambient-lights automation -- dimmers come back at half brightness rather than
# full ON.
#
# One instance per room keeps trigger subscriptions scoped to that room's
# hosts, so other rooms' players never fire this execution chain. Deploying
# several rooms in ONE instance also works if you prefer it.
#
# Requires video players defined under `videoPlayers` in etc/device/network.yaml
# (see the MPC-HC / VLC setup notes there).
#
# The automation opts into `override_human_interaction` so it is "sticky" while
# active: manual changes to its target devices are re-corrected on the next tick
# rather than being deferred to a human-interaction cooldown.

override_human_interaction: true

sensors:
  illuminance: 'Outdoor Luminance'

triggers_zigbee:
  - 'Outdoor Luminance'

timer_interval: "15m"

# Rule "targets:" keys are your own Zigbee device names (must exist in zigbee.yaml)
# with spaces replaced by underscores -- no separate declaration list needed.

triggers_video:
  - my-pc

triggers_network:
  - my-pc

rules:
  # Rollers are owned while the player answers HTTP; handed back to the room's own
  # roller automation when it goes offline -- replace placeholder names with your
  # installed automations. `force: true` makes them act even if a once/silent guard
  # would otherwise block (human cooldowns still apply).
  - name: 'Office: player reachable - close rollers'
    conditions:
      presence: { my-pc: true }
      video-player: { my-pc: [playing, paused, stopped] }
    targets:
      Living_Room_Roller_Left: CLOSE

  - name: 'Office: player gone - hand rollers back to their owner'
    conditions:
      presence: { my-pc: false }
      video-player: { my-pc: [unknown, unreachable] }
    invoke_automation: { name: HomeOfficeRollersAutomation, force: true }

  # Light restore is done locally from this rule instead of delegated to the ambient-
  # lights automation: on pause/stop/gone the lamp set comes back, gated by time of day
  # + outdoor illuminance. No `presence` gate so an offline machine also restores the
  # lights. Dimmers take a structured `{brightness: 0-100}` command (percentage mapped
  # per-channel at publish time) instead of plain ON.
  - name: 'Office: not playing - restore ambient lighting'
    conditions:
      video-player: { my-pc: [paused, stopped, unreachable, unknown] }
      time-of-day: [afternoon, evening, night]
      illuminance: { lt: 900 }
    targets:
      Living_Room_Plug: ON
      Kitchen_Plug: ON
      Living_Room_Dimmer: { brightness: 50 }

  - name: 'Office: playing - dark mode (lights off)'
    conditions:
      presence: { my-pc: true }
      video-player: { my-pc: [playing] }
    targets:
      Living_Room_Plug: OFF
      Kitchen_Plug: OFF
