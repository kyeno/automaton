# Morning Lights Automation Configuration
# Turns off specified lights during morning when natural light is sufficient.
#
# Copy this file to "morning-lights.yaml" and customize device names.

devices:
  - 'Kitchen Outlet'
  - 'Hallway Outlet'

sensors:
  illuminance: 'Outdoor Luminance'

triggers_zigbee:
  - 'Outdoor Luminance'

timer_interval_ms: 60000

rules:
  - name: 'Morning bright - turn off lights'
    conditions:
      time-of-day: [morning]
      illuminance: { gte: 20 }
    action: OFF