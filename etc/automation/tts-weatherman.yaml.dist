# ttsWeatherMan Configuration Template
# Rule-based TTS weather announcer with sensor data interpolation.
#
# Builds a speech message from a base sentence and condition-matched additions,
# then routes through AI → TTS pipeline (or direct TTS if AI unavailable).
#
# Sensor values can be interpolated into i18n strings using {{ DeviceName.property }}
# syntax (e.g., "{{ Outdoor Temperature.temperature }}" resolves to live sensor data).
#
# When multiple rules match, only the one with the highest priority fires.
# Default priority is 0 if not specified. Higher number = higher precedence.
#
# Copy this file to "tts-weatherman.yaml" and customize for your home.

timer_interval_ms: 900000   # 15 minutes (set to 0 to disable timer)
silence_between: null             # Optional: suppress execution between these local times (HHmm-HHmm format), e.g. "0230-0930"

sentence_base: 'weatherman.base'           # Always-played opening i18n key
sentence_ai_prefix: 'weatherman.ai_prefix' # Prepend when routing through AI

sensors:
  illuminance: 'Outdoor Luminance'
  temperature: 'Outdoor Temperature'
  humidity: 'Outdoor Temperature'          # Same device as temp (combined sensor)
  pressure: 'Kitchen Temperature'           # Separate barometer (may vary)

rules:
  - name: 'Warm day'
    priority: 1
    conditions:
      time-of-day: [morning, noon, afternoon]
      temperature: { lte: 25, gte: 18 }
      humidity: { lte: 55 }
    sentence: 'weatherman.soothing_warm_day'

  - name: 'Hot day'
    priority: 2
    conditions:
      time-of-day: [morning, noon, afternoon]
      temperature: { gt: 25 }
    sentence: 'weatherman.warning_hot_day'

  - name: 'Hot and humid day'
    priority: 3
    conditions:
      temperature: { gte: 26 }
      humidity: { gte: 50 }
    sentence: 'weatherman.warning_stay_at_home'

  - name: 'Too hot day'
    priority: 4
    conditions:
      temperature: { gte: 29 }
    sentence: 'weatherman.warning_stay_at_home'

  - name: 'Apocalypse'
    priority: 5
    conditions:
      temperature: { gte: 30 }
      humidity: { gte: 55 }
    sentence: 'weatherman.warning_apocalypse'

  - name: 'Humid night'
    priority: 3
    conditions:
      time-of-day: [evening, night]
      temperature: { gte: 18 }
      humidity: { gte: 65 }
    sentence: 'weatherman.warning_humid_night'

  - name: 'Chill evening'
    priority: 1
    conditions:
      time-of-day: [evening, night]
      temperature: { lte: 18 }
    sentence: 'weatherman.warning_chill_night'

  - name: 'Warm evening'
    priority: 2
    conditions:
      time-of-day: [evening, night]
      temperature: { gt: 18, lte: 20 }
    sentence: 'weatherman.soothing_warm_night'
