# ttsWeatherMan Configuration
# Rule-based TTS weather announcer; sensor values interpolate into i18n strings via
# {{ DeviceName.property }}. Highest-priority matching rule wins (default 0).
# Reference: doc/automations/weatherman.md
#
# Template -- copy to tts-weatherman.yaml and customize for your home.

timer_interval: "1h"

silence_between: "2300-0600"     # Suppress execution between these local times (HHmm-HHmm); set to null to disable

# Event-driven numeric history is independent of this automation's speech schedule.
history:
  enabled: true
  window: "1h"              # compare the last hour's mean with the preceding hour
  max_gap: "30m"            # do not carry a reading forward beyond this age
  min_coverage: 0.8         # require observed coverage of at least 80% in BOTH windows
  tolerances: { temperature: 0.2, humidity: 2, pressure: 0.5 }

sentence_base: 'weatherman.base'           # Always-played opening i18n key
sentence_ai_prefix: 'weatherman.ai_prefix' # Prepend when routing through AI

# OPTIONAL -- add a random proverb from etc/i18n/<locale>/proverbs.txt to every
# announcement, before the "next update" closer. Two keys, one per output path:
#   ai_proverb  -- direction carried in the AI prompt
#   tts_proverb -- spoken verbatim by direct TTS
add_proverb: false

# OPTIONAL -- route reports through the AI engine before TTS (default ON)
use_ai: true

sensors:
  illuminance: 'Outdoor Luminance'
  temperature: 'Outdoor Temperature'
  humidity: 'Outdoor Temperature'          # Same device as temp (combined sensor)
  pressure: 'Kitchen Temperature'           # Separate barometer (may vary)

# OPTIONAL -- extra params forwarded into every TTS request; a `tts_profile` from the locale
# tts.yaml registry can supply the same fields (explicit entries win). Waves must exist on
# the TTS server; intro_spacing may be negative (= overlap).
tts_options:
  intro:          # Wave filename played before the synthesized speech
  outro:          # Wave filename played after the synthesized speech
  intro_spacing:  # Seconds between intro end and speech start; negative = overlap

# Stand-down guard: stay quiet while these players are playing; force does NOT bypass
video_player_suppression:
  my-pc: [playing]      # Home theater / HTPC player
  laptop: [playing]   # Bedroom player

rules:
  - name: 'Warm day'
    priority: 1
    conditions:
      time_of_day: [morning, noon, afternoon]
      temperature: { lte: 25, gte: 18 }
      humidity: { lte: 55 }
    sentence: 'weatherman.soothing_warm_day'

  - name: 'Hot day'
    priority: 2
    conditions:
      time_of_day: [morning, noon, afternoon]
      temperature: { gt: 25 }
    sentence: 'weatherman.warning_hot_day'

  - name: 'Hot and humid day'
    priority: 3
    conditions:
      temperature: { gte: 26 }
      humidity: { gte: 50 }
    sentence: 'weatherman.warning_humid_stay_at_home'

  - name: 'Too hot day'
    priority: 4
    conditions:
      temperature: { gte: 29 }
    sentence: 'weatherman.warning_hot_stay_at_home'

  - name: 'Apocalypse'
    priority: 5
    conditions:
      temperature: { gte: 30 }
      humidity: { gte: 55 }
    sentence: 'weatherman.warning_apocalypse'

  - name: 'Humid night'
    priority: 3
    conditions:
      time_of_day: [evening, night]
      temperature: { gte: 18 }
      humidity: { gte: 65 }
    sentence: 'weatherman.warning_humid_night'

  - name: 'Chill evening'
    priority: 1
    conditions:
      time_of_day: [evening, night]
      temperature: { lte: 18 }
    sentence: 'weatherman.warning_chill_night'

  - name: 'Warm evening'
    priority: 2
    conditions:
      time_of_day: [evening]
      temperature: { gt: 18 }
    sentence: 'weatherman.soothing_warm_evening'

  - name: 'Warm night'
    priority: 2
    conditions:
      time_of_day: [night]
      temperature: { gt: 18 }
    sentence: 'weatherman.soothing_warm_night'
