# Home Office Rollers Automation Configuration
# Rule-based roller-shutter controller for a home office (or any room with blinds).
# Evaluates outdoor illuminance + temperature against time-of-day and network-presence
# rules, then merges matching results per target using "most-closed-wins" logic.
# Presence hostnames must match entries in etc/device/network.yaml.
# Reference: doc/automations/home-office-rollers.md
#
# Template -- copy to home-office-rollers.yaml and customize device names, hostnames and rules.

# Rule "targets:" keys are zigbee2mqtt friendly names with spaces replaced by
# underscores (casing kept) -- they must exist in your setup; no separate list needed.

sensors:
  illuminance: 'Outdoor Luminance'
  temperature: 'Outdoor Temperature'

triggers_zigbee:
  - 'Outdoor Luminance'
  - 'Outdoor Temperature'

triggers_network:
  - laptop
  - my-pc

timer_interval: "1m"

# Stand-down guard: while a listed player is in a listed status, the whole automation
# stands down. Hosts combine with OR; statuses: playing, paused, stopped, offline.
# Individual rules may opt out via `ignore_video_player_suppression: true`.
video_player_suppression:
  my-pc: [playing, paused, stopped]

rules:
  # Minute-precision clock bound: 1230 == 12:30 (also accepted: '12:30', 12.5).
  - name: 'Morning: Hot - close'
    conditions:
      time_of_day: [morning, noon]
      hour: { lte: 1230 }
      temperature: { gte: 25 }
    targets:
      Home_Office_Roller_Left: CLOSE
      Home_Office_Roller_Right: CLOSE

  # Gated on civil dawn ("sunrise" resolves to civil twilight, not the geometric disc
  # edge); the gt: 15 floor keeps this out of the darkness-close tick.
  - name: 'Anytime: Warm, not too bright - open'
    conditions:
      time_of_day: [morning, noon, afternoon, evening]
      hour: { gte: sunrise }
      illuminance: { gt: 15, lt: 11000 }
      temperature: { lt: 25 }
    targets:
      Home_Office_Roller_Left: OPEN
      Home_Office_Roller_Right: OPEN

  - name: 'Afternoon: Hot - open'
    conditions:
      time_of_day: [afternoon]
      temperature: { gte: 25, lte: 29 }
    targets:
      Home_Office_Roller_Left: OPEN
      Home_Office_Roller_Right: OPEN

  - name: 'Afternoon: Extremely hot - close'
    conditions:
      time_of_day: [noon, afternoon]
      temperature: { gte: 29 }
    targets:
      Home_Office_Roller_Left: CLOSE
      Home_Office_Roller_Right: CLOSE

  # Park rule: the gte: 200 illuminance floor is what makes it one -- at 200 lux and up
  # its partial positions out-vote every OPEN in the same tick (most-closed-wins).
  - name: 'Day: laptop present, not too bright'
    conditions:
      time_of_day: [morning, noon, afternoon]
      hour: { gte: sunrise }
      illuminance: { gte: 200, lte: 11000 }
      presence: laptop
    targets:
      Home_Office_Roller_Left: 40
      Home_Office_Roller_Right: 12

  - name: 'Day: laptop present, bright'
    conditions:
      time_of_day: [morning, noon, afternoon]
      illuminance: { gt: 11000, lte: 12700 }
      presence: laptop
    targets:
      Home_Office_Roller_Left: 12
      Home_Office_Roller_Right: CLOSE

  - name: 'Day: laptop present, direct sunlight'
    conditions:
      time_of_day: [morning, noon]
      illuminance: { gt: 12700 }
      presence: laptop
    targets:
      Home_Office_Roller_Left: 10
      Home_Office_Roller_Right: CLOSE

  - name: 'Evening: laptop present, mid-dark'
    conditions:
      time_of_day: [evening]
      illuminance: { gt: 250, lte: 1800 }
      presence: laptop
    targets:
      Home_Office_Roller_Left: OPEN
      Home_Office_Roller_Right: 35

  - name: 'Evening: laptop present, not too bright'
    conditions:
      time_of_day: [evening]
      illuminance: { gt: 1800, lte: 11000 }
      presence: laptop
    targets:
      Home_Office_Roller_Left: 80
      Home_Office_Roller_Right: 30

  - name: 'Anytime: desktop present, not too bright'
    conditions:
      time_of_day: [morning, noon, afternoon, evening]
      illuminance: { lte: 11000 }
      presence: my-pc
    targets:
      Home_Office_Roller_Left: 30
      Home_Office_Roller_Right: 70

  - name: 'Anytime: desktop present, bright'
    conditions:
      time_of_day: [morning, noon, afternoon, evening]
      illuminance: { gt: 11000, lte: 12700 }
      presence: my-pc
    targets:
      Home_Office_Roller_Left: 15
      Home_Office_Roller_Right: 30

  - name: 'Night: Close all'
    conditions:
      time_of_day: [evening, night]
      illuminance: { lte: 15 }
    targets:
      Home_Office_Roller_Left: CLOSE
      Home_Office_Roller_Right: CLOSE
