# Home Office Rollers Automation Configuration
# Rule-based roller-shutter controller for a home office (or any room with blinds).
# Evaluates outdoor illuminance + temperature against time-of-day and network-presence
# rules, then merges matching results per target using "most-closed-wins" logic.
#
# Copy this file to "home-office-rollers.yaml" and customize device names, hostnames,
# thresholds and rules for your home. Presence hostnames must match entries in
# etc/device/network.yaml.
#
# Each automation also needs a companion JavaScript class that extends
# RuleBasedAutomationBase (see homeOfficeRollersAutomation.js or exampleAutomation.js.dist).

# Rule "targets:" keys are your zigbee2mqtt device names with spaces replaced by
# underscores (casing kept) -- they must exist in your setup; no separate list needed.

sensors:
  illuminance: 'Outdoor Luminance'
  temperature: 'Outdoor Temperature'

triggers_zigbee:
  - 'Outdoor Luminance'
  - 'Outdoor Temperature'

triggers_network:
  - my-laptop
  - my-desktop

timer_interval: "1m"

# Optional stand-down guard: while any listed player is in one of the listed
# statuses, the whole automation stands down (e.g., so it does not fight a
# home-theater automation over the same rollers). Hosts combine with OR;
# statuses: playing, paused, stopped, offline. Individual rules
# may opt out via `ignore_video_player_suppression: true`.
video_player_suppression:
  my-pc: [playing, paused, stopped]

rules:
  # The 12:30 boundary: from just after midday the sun sits directly above the building and
  # no longer overheats the room, so the morning shading must release at 12:30 -- not at
  # 12:00, and not at 13:00. `hour:` bounds accept minute-precision clock times (NATO-style
  # HHMM, 'HH:MM', or a fractional hour), so a mid-day boundary is writeable at all; a plain
  # hour bound tops out at 23 and a bare 1230 there would be a silent no-op.
  - name: 'Morning: Hot - close'
    conditions:
      time_of_day: [morning, noon]
      hour: { lte: 1230 }
      temperature: { gte: 25 }
    targets:
      Home_Office_Roller_Left: CLOSE
      Home_Office_Roller_Right: CLOSE

  # Gated behind civil dawn (`sunrise`/`sundawn` resolve to civil twilight, not the
  # geometric disc edge). A pre-dawn tick already reads daytime on the street sensor --
  # without the gate the windows throw open in pitch darkness. The `gt: 15` floor keeps the
  # darkness-close rule and this one from competing over the same tick.
  - name: 'Anytime: Warm, not too bright - open'
    conditions:
      time_of_day: [morning, noon, afternoon, evening]
      hour: { gte: sunrise }
      illuminance: { gt: 15, lt: 11000 }
      temperature: { lt: 25 }
    targets:
      Home_Office_Roller_Left: OPEN
      Home_Office_Roller_Right: OPEN

  - name: 'Afternoon: Hot - open'
    conditions:
      time_of_day: [afternoon]
      temperature: { gte: 25, lte: 29 }
    targets:
      Home_Office_Roller_Left: OPEN
      Home_Office_Roller_Right: OPEN

  - name: 'Afternoon: Extremely hot - close'
    conditions:
      time_of_day: [noon, afternoon]
      temperature: { gte: 29 }
    targets:
      Home_Office_Roller_Left: CLOSE
      Home_Office_Roller_Right: CLOSE

  # The park rule. The `gte: 200` illuminance floor is what makes it a park rule: below it
  # the daylight rules above are free to open the windows, and at 200 lux and up this rule's
  # partial positions out-vote every OPEN in the same tick (most-closed-wins). Without the
  # floor it fired in dim light, permanently shading the room and out-voting OPEN -- the
  # classic "PC online but windows stuck half-closed" symptom.
  - name: 'Day: laptop present, not too bright'
    conditions:
      time_of_day: [morning, noon, afternoon]
      hour: { gte: sunrise }
      illuminance: { gte: 200, lte: 11000 }
      presence: my-laptop
    targets:
      Home_Office_Roller_Left: 40
      Home_Office_Roller_Right: 12

  - name: 'Day: laptop present, bright'
    conditions:
      time_of_day: [morning, noon, afternoon]
      illuminance: { gt: 11000, lte: 12700 }
      presence: my-laptop
    targets:
      Home_Office_Roller_Left: 12
      Home_Office_Roller_Right: CLOSE

  - name: 'Day: laptop present, direct sunlight'
    conditions:
      time_of_day: [morning, noon]
      illuminance: { gt: 12700 }
      presence: my-laptop
    targets:
      Home_Office_Roller_Left: 10
      Home_Office_Roller_Right: CLOSE

  - name: 'Evening: laptop present, mid-dark'
    conditions:
      time_of_day: [evening]
      illuminance: { gt: 250, lte: 1800 }
      presence: my-laptop
    targets:
      Home_Office_Roller_Left: OPEN
      Home_Office_Roller_Right: 35

  - name: 'Evening: laptop present, not too bright'
    conditions:
      time_of_day: [evening]
      illuminance: { gt: 1800, lte: 11000 }
      presence: my-laptop
    targets:
      Home_Office_Roller_Left: 80
      Home_Office_Roller_Right: 30

  - name: 'Anytime: desktop present, not too bright'
    conditions:
      time_of_day: [morning, noon, afternoon, evening]
      illuminance: { lte: 11000 }
      presence: my-desktop
    targets:
      Home_Office_Roller_Left: 30
      Home_Office_Roller_Right: 70

  - name: 'Anytime: desktop present, bright'
    conditions:
      time_of_day: [morning, noon, afternoon, evening]
      illuminance: { gt: 11000, lte: 12700 }
      presence: my-desktop
    targets:
      Home_Office_Roller_Left: 15
      Home_Office_Roller_Right: 30

  - name: 'Night: Close all'
    conditions:
      time_of_day: [evening, night]
      illuminance: { lte: 15 }
    targets:
      Home_Office_Roller_Left: CLOSE
      Home_Office_Roller_Right: CLOSE
