# Network Device Configuration
# Lists computers, routers, access points and appliances on your network.
# Used by automations for presence detection via ping checks.
# Reference: doc/monitors/network-presence.md, doc/monitors/video-player.md
#
# Template -- copy to network.yaml and replace placeholders with your actual devices.

computers:
  # Replace hostname/ip pairs with your own machines
  my-pc: 0.0.0.0
  laptop: 0.0.0.0

# Mission-critical hosts: polled by NetworkPresence; a spoken warning is announced when
# one stops answering. Names: etc/automaton.yaml -> alerts.network_offline_devices;
# sentences: etc/i18n/<locale>/alerts.yaml (doc/monitors/offline-alerts.md).
servers:
  # core-server: 0.0.0.0
  # dns-server: 0.0.0.0
  # wifi-router: 0.0.0.0

routers:
  # - "Router Name": 0.0.0.0

ac:
  # Access points for optional monitoring
  # - "AC Name": 0.0.0.0

appliances:
  # Smart appliances tracked on the network
  # - "Appliance Name": 0.0.0.0

# Video players polled by the VideoPlayerMonitor. Each entry is an object (not a bare IP),
# so NetworkPresence does not ping it. The IP resolves from the same-named "computers"
# entry, or from an optional "host" key.
#   parser     -- response parser: vlc (VLC HTTP API, /requests/status.json)
#                or mpc (MPC-HC web interface, /variables.html)
#   timeout -- optional per-player fetch timeout (default 1200 ms)
# MPC-HC: enable the web interface under View -> Options -> Player -> Web Interface
# ("Listen on port" on, "Allow access from localhost only" off).
videoPlayers:
  # my-pc:                          # IP resolved from computers: my-pc
  #   port: 8080
  #   path: /requests/status.json
  #   parser: vlc
  #   # VLC requires a password (Lua HTTP Password); sent as basic auth:
  #   # username: ''
  #   # password: 'your-vlc-password'
  # living-room:                     # Explicit host override (failsafe)
  #   host: 0.0.0.0
  #   port: 13579
  #   path: /variables.html
  #   parser: mpc
