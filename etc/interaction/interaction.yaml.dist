# Interactions Configuration
# Interactions triggered by Zigbee devices.
#   name   -- unique id (snake_case); also the EventBus topic "zigbee:{name}"
#   actions -- action definitions, each with a type plus targets or calls
# Action types:
#   targets -- direct device commands: array of {device, command}
#   calls   -- delegate to another named interaction's execute()
#
# Template -- copy to interaction.yaml and customize for your setup.

interactions:
  # Example: Remote controlling two roller shutters in a room.
  - name: 'living_room_remote'
    actions:
      - type: '1_single'
        targets:
          - device: 'Living Room Roller Left'
            command: 'OPEN'
          - device: 'Living Room Roller Right'
            command: 'OPEN'
      - type: '2_single'
        targets:
          - device: 'Living Room Roller Left'
            command: 'STOP'
          - device: 'Living Room Roller Right'
            command: 'STOP'
      - type: '3_single'
        targets:
          - device: 'Living Room Roller Left'
            command: 'CLOSE'
          - device: 'Living Room Roller Right'
            command: 'CLOSE'

  # Example: Physical switch toggling an outlet.
  - name: 'kitchen_switch'
    actions:
      - type: 'single'
        targets:
          - device: 'Kitchen Outlet'
            command: 'TOGGLE'

  # Example: Pilot remote controlling bedroom roller shutters while delegating
  # travel to a custom JS interaction (see bedroomRollersInteraction.js.dist) --
  # single press full travel, double press 20% step, end-stop beep. STOP stays declarative.
  - name: 'bedroom_pilot_remote'
    actions:
      - type: '1_single'
        calls: 'bedroomRollersInteraction'
      - type: '2_single'
        targets:
          - device: 'Bedroom Roller Left'
            command: 'STOP'
          - device: 'Bedroom Roller Right'
            command: 'STOP'
      - type: '3_single'
        calls: 'bedroomRollersInteraction'
      - type: '1_double'
        calls: 'bedroomRollersInteraction'
      - type: '3_double'
        calls: 'bedroomRollersInteraction'
