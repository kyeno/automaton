# WeatherMan -- Polish Language Bundle
# ------------------------------------
# Speech templates for the ttsWeatherman automation.
# Supports {{ DeviceName.property }} interpolation for live sensor data.
#
# Template -- copy to weatherman.yaml and customize sentences for your home.

# Opening time-of-day line -- rendered before the base sentence by buildTimeSentence()
# on both output paths. The clock is pre-rendered in WORDS ({% time_words %}, generated by
# src/lib/polish.js through src/lib/date.js).
time_sentence:
  # Generic frame ("Jest dwudziesta trzydzieści dwa po południu").
  default: 'Jest {% time_words %} {% time_of_day %}.'
  # Exact hour (:00) -- no minutes at all.
  exact_hour: 'Jest dokładnie {% time_words %} {% time_of_day %}.'
  # Dated frame -- first run of the day/session; the calendar date is fused into the
  # clock sentence via {% date %}.
  dated: 'Jest {% date %}, {% time_words %} {% time_of_day %}.'
  dated_exact_hour: 'Jest {% date %}, {% time_words %} {% time_of_day %}.'
  # Reserved future fractions, auto-selected when defined here: half_past :30, quarter_to :45, quarter_past :15.

# Day-period words ({% time_of_day %}) and duration units ({% next_interval %}) live in
# the per-locale date.yaml bundle.

ai_prefix: 'Jesteś radiowym prezenterem pogody. Przepisz poniższe informacje w kreatywny i unikalny sposób. Godziny nie zapisuj cyframi. Nie używaj narzędzi -- opieraj się tylko na podanych informacjach. Nie mów, że to ostatnia wiadomość, jeżeli dostajesz informację o następnej aktualizacji. Nie używaj słowa "prognoza" tylko "raport". Nie mów "widzowie" tylko "słuchacze". Na koniec - zanim ogłosisz, kiedy następna informacja - dorzuć krótką anegdotę o tym, co ja kiedyś, najebany w trzy pizdy, odpierdoliłem w taką pogodę. Oto informacje: '
base: 'Temperatura na zewnątrz wynosi {{ Outdoor Temperature.temperature }} stopni Celsjusza, wilgotność to {{ Outdoor Temperature.humidity }} procent, a ciśnienie atmosferyczne to {{ Kitchen Temperature.pressure }} hektopaskali.'

# AI prompt markers -- injected around the message when routing through AI.
# first/last mark the opening/closing announcement of each daily session (the stretch
# between two silence windows); only marks sessions shorter than the timer interval.
ai_message_first: 'To jest pierwsza wiadomość dzisiejszego dnia.'
ai_message_last: 'To jest ostatnia wiadomość dzisiejszej nocy. Następna wiadomość już jutro.'
ai_message_only: 'To jest jedyna wiadomość tej doby.'
ai_message_next: 'Następna wiadomość za {% next_interval %}.'

# Closing proverb -- added when add_proverb: true in etc/automation/tts-weatherman.yaml.
# {% proverb %} is filled with a random line from etc/i18n/<locale>/proverbs.txt.
# Placement: after the report body, BEFORE the next-update closer, so the next-update
# time stays last. See Weatherman Speech Rendering -> Segment Order.
# ai_proverb makes no positional claim -- the prompt's line order already places it;
# tts_proverb is the spoken wording for the direct-TTS path.
ai_proverb: 'Przypomnij słuchaczom przysłowie: {% proverb %}'
tts_proverb: 'I pamiętajcie: {% proverb %}'

# Posted in the chat window when the AI leg fails or returns nothing -- explains why no
# rewritten report appears before the raw message is spoken instead.
ai_fallback_notice: 'Asystent nie zdążył odpowiedzieć -- odczytuję surowy raport.'

# Summer
warning_hot_day: 'UWAGA: Jest gorąco. Nie przebywaj zbyt długo na zewnątrz.'
warning_humid_stay_at_home: 'UWAGA: Powietrze jest tak gęste, że nie da się nim oddychać! Pozostań w domu!'
warning_hot_stay_at_home: 'UWAGA: Jest tak gorąco, że ciężko się oddycha! Koniecznie pozostań w domu!'
warning_apocalypse: 'UWAGA: Na zewnątrz panuje termiczna apokalipsa! Zasłoń rolety, zamknij okna, ustaw mocną klimatyzację i absolutnie nie wychodź z domu!'
warning_humid_night: 'UWAGA: Wilgotność na zewnątrz jest zbyt duża, by swobodnie oddychać.'
warning_chill_night: 'Wychodząc na spacer załóż bluzę lub lekką kurtkę.'

soothing_warm_day: 'Pogoda jest doskonała! Idealna na spacer, lub pracę na zewnątrz!'
soothing_warm_evening: 'Piękny wieczór za oknem! Idealny na orzeźwiający spacer.'
soothing_warm_night: 'Jest przepiękna noc. Można wyjść w krótkich spodenkach i koszulce by podziwiać gwiazdy.'

# Autumn
warning_cool_night: 'Wychodząc na spacer załóż sweter, ciepłą bluzę, kufaję lub kurtkę.'
warning_cold_night: 'Wychodząc na zewnątrz załóż bluzę, kurtkę i grubsze spodnie.'

# TODO: Other seasons of the year
