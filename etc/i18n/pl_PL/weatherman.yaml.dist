# WeatherMan -- Polish Language Bundle
# ------------------------------------
# Speech templates for the ttsWeatherman automation.
# Supports {{ DeviceName.property }} interpolation for live sensor data.
#
# Copy this file to "weatherman.yaml" and customize sentences for your home.

# Opening time-of-day line -- rendered BEFORE the base sentence by buildTimeSentence()
# on both output paths (AI rewrite and direct TTS). Style is picked by the global
# stupid_ai_engine switch (AI section of automaton.yaml): explicit (true/default)
# pre-renders clock parts as plain digits
# so even tiny models never convert a clock string into words; smart (false) leaves
# {% time %} for the model to spell out itself.
time_sentence:
  smart:
    default: 'Jest godzina {% time %}.'
  explicit:
    # Generic frame ("Jest 32 minut po godzinie 9 rano"); the small model only inflects
    # unit/ordinal forms into natural speech during its rewrite.
    default: 'Jest {% minutes %} minut po godzinie {% hours %} {% time_of_day %}'
    # Exact hour (:00) -- no minutes at all.
    exact_hour: 'Jest dokładnie godzina {% hours %} {% time_of_day %}'
    # Reserved future fractions, auto-selected when defined here: half_past :30, quarter_to :45, quarter_past :15.

# Localized day-period words for {% time_of_day %}; same pattern as duration_units below.
period_words:
  morning: 'rano'
  noon: 'w południe'
  afternoon: 'po południu'
  evening: 'wieczorem'
  night: 'w nocy'

ai_prefix: 'Jesteś prezenterem pogody. Przepisz poniższe informacje w kreatywny i unikalny sposób, a godzinę i minuty napisz słownie. Nie używaj narzędzi -- opieraj się tylko na podanych informacjach. Nie mów, że to ostatnia wiadomość, jeżeli dostajesz informację o następnej aktualizacji. Nie używaj słowa "prognoza" tylko "raport". Oto informacje: '
base: 'Temperatura na zewnątrz wynosi {{ Outdoor Temperature.temperature }} stopni Celsjusza, wilgotność to {{ Outdoor Temperature.humidity }} procent, a ciśnienie atmosferyczne to {{ Kitchen Temperature.pressure }} hektopaskali.'

# AI prompt markers -- injected around the message when routing through AI.
# first/last mark the opening/closing announcement of each daily session (the stretch
# between two silence windows); only marks sessions shorter than the timer interval.
ai_message_first: 'To jest pierwsza wiadomość dzisiejszego dnia.'
ai_message_last: 'To jest ostatnia wiadomość dzisiejszej nocy.'
ai_message_only: 'To jest jedyna wiadomość tej doby.'
ai_message_next: 'Następna wiadomość za {% next_interval %}.'

# Localized unit words for {% next_interval %}; the model inflects them to fit the number.
duration_units:
  day: 'dni'
  hour: 'godzin'
  minute: 'minut'
  second: 'sekund'

# Summer
warning_hot_day: 'UWAGA: Jest gorąco. Nie przebywaj zbyt długo na zewnątrz.'
warning_humid_stay_at_home: 'UWAGA: Powietrze jest tak gęste, że nie da się nim oddychać! Pozostań w domu!'
warning_hot_stay_at_home: 'UWAGA: Jest tak gorąco, że ciężko się oddycha! Koniecznie pozostań w domu!'
warning_apocalypse: 'UWAGA: Na zewnątrz panuje termiczna apokalipsa! Zasłoń rolety, zamknij okna, ustaw mocną klimatyzację i absolutnie nie wychodź z domu!'
warning_humid_night: 'UWAGA: Wilgotność na zewnątrz jest zbyt duża, by swobodnie oddychać.'
warning_chill_night: 'Wychodząc na spacer załóż bluzę lub lekką kurtkę.'

soothing_warm_day: 'Pogoda jest doskonała! Idealna na spacer, lub pracę na zewnątrz!'
soothing_warm_night: 'Jest przepiękna noc. Można wyjść w krótkich spodenkach i koszulce by podziwiać gwiazdy.'

# TODO: Other seasons of the year
