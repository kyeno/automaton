# Greeter -- Polish Language Bundle (Template)
# ---------------------------------------------
# Speech templates for the ttsGreeter automation (greetings on computer return).
# Each section holds per-host lines split by output path:
#   <bucket>.tts.<host> -- spoken verbatim when use_ai is off / AI unavailable
#   <bucket>.ai.<host>  -- instruction sent to the model; it speaks its own greeting
# Placeholders: {% name_vocative %} and {% name_genitive %} are filled from names.<host>,
# so pick whichever case your sentence grammar needs ("Witaj, Macieju!" vs "komputer Macieja").
# Add more buckets freely and reference them from greeting_windows in tts-greeter.yaml.
#
# Copy this file to "greeter.yaml" and customize sentences + host names for your home.

names:
  hostname1: { vocative: 'Janie', genitive: 'Jana' }
  hostname2: { vocative: 'Zosiu', genitive: 'Zosię' }

welcome:
  tts:
    hostname1: 'Witaj z powrotem, {% name_vocative %}!'
    hostname2: 'Witaj z powrotem, {% name_vocative %}!'
  ai:
    hostname1: 'Powitaj ciepło i krótko {% name_genitive %}, który właśnie wrócił do domu.'
    hostname2: 'Powitaj ciepło i krótko {% name_genitive %}, która właśnie wróciła do domu.'

forgot:
  tts:
    hostname1: 'Witaj ponownie, {% name_vocative %}. Zapomniałeś czegoś?'
    hostname2: 'Witaj ponownie, {% name_vocative %}. Zapomniałaś czegoś?'
  ai:
    hostname1: 'Powiedz krótko i z przymrużeniem oka, że {% name_genitive %} pewnie coś zapomniał. Powitaj go.'
    hostname2: 'Powiedz krótko i z przymrużeniem oka, że {% name_genitive %} pewnie coś zapomniała. Powitaj ją.'

reboot:
  tts:
    hostname1: 'I bum -- komputer {% name_genitive %} właśnie się rebootował!'
    hostname2: 'I bum -- komputer {% name_genitive %} właśnie się rebootował!'
  ai:
    hostname1: 'Ogłoś krótko i z humorem, że komputer {% name_genitive %} właśnie się rebootował.'
    hostname2: 'Ogłoś krótko i z humorem, że komputer {% name_genitive %} właśnie się rebootował.'

# Absence note -- appended AFTER the bucket greeting (space-separated) whenever the
# transition history provides an absence duration. Variant choice by length:
#   short -- absence <= absence_note_long_after (config default 12h): how long it was off
#   long  -- above that threshold: calendar date of the moment it went offline
# TTS variants come in _named / _anonymous pairs: the possessive form is spoken only when
# this host's welcome.tts line addresses them by name ({% name_vocative %}/{% name_genitive %});
# machines without a personal greeting get the neutral "Komputer ..." form instead.
# Placeholders: {% time_phrase %} -> localized duration incl. unit word ("58 minut");
#               {% last_online_date %} -> localized calendar date from the date bundle.
absence_note:
  tts:
    short_named:     'Twój komputer był wyłączony przez {% time_phrase %}'
    short_anonymous: 'Komputer był wyłączony przez {% time_phrase %}'
    long_named:      'Twój komputer ostatnio był włączony {% last_online_date %}'
    long_anonymous:  'Komputer ostatnio był włączony {% last_online_date %}'
  ai:
    short: 'Dodatkowo wspomnij, że komputer był wyłączony przez {% time_phrase %}.'
    long:  'Dodatkowo wspomnij, że komputer ostatnio był włączony {% last_online_date %}.'
