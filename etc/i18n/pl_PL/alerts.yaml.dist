# Alert Sentences -- Polish Locale (distribution template)
# ---------------------------------------------------------
# Spoken warnings for notable system events (see doc/monitors/offline-alerts.md).
# The {device} placeholder is replaced with the device's friendly name.
# Keys may be plain sentences, or per-device maps with a `default` entry -- the
# per-device entries below are examples; keep only the hosts you watch.

# A configured Zigbee device left the network
zigbee_device_offline: "Uwaga, urządzenie {device} zeszło z sieci Zigbee."

# A mission-critical network host went offline (names from etc/device/network.yaml)
network_device_offline:
  default: "Uwaga, {device} jest offline."
  # core-server: "Uwaga, serwer core jest offline."

# A watched host came back (spoken only with alerts.network_offline_announce_recovery: true)
network_device_online:
  default: "{device} znowu działa."
  # core-server: "Serwer core znowu działa."
