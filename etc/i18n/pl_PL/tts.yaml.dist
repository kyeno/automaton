# TTS Configuration -- Polish Locale
# -----------------------------------
# Template merged into every TTS API request for this locale.
# "model" is REQUIRED. All other fields are OPTIONAL.
#
# Template -- copy to tts.yaml and customize voice model for your setup.

# REQUIRED - Voice model identifier for tts-server
model: "pl_PL-bass-high"

# OPTIONAL - Phoneme handling for Polish triple consonants
triple_leading_consonant: true

# OPTIONAL - Piper TTS engine effects
piper_effects: "--length_scale 1.15"

# OPTIONAL - SoX audio post-processing effects
sox_effects: "pad 1.2 0.5"

# OPTIONAL - Override output_endpoint per-request via event payload instead
# If not set here or in the event, falls back to TTS_TCP_ENDPOINT in .env
# output_endpoint: "0.0.0.0:12345"

# ---------------------------------------------------------------------
# OPTIONAL - Named framing profiles: intro/outro waves for a class of speech,
# referenced by name from a speaker's `tts_profile:` (automation YAML,
# alerts.<family>_tts_profile, ui.tts_profile). Framing only -- no output_endpoint.
# Point them at wave files that exist on the TTS server
# (waveset manifest: doc/installation/tts-integration.md).
# ---------------------------------------------------------------------
profiles:
  # alarm:                        # mission-critical offline alerts
  #   intro: 'alarm.wav'
  #   intro_spacing: -1.5
  # greeting:                     # greeter + gardener reports
  #   intro: 'hello.wav'
  #   outro: 'bye.wav'
  # sundawn:                      # ttsTwilight -- civil dawn announcement
  #   intro: 'dawn.wav'
  #   intro_spacing: 0
  # sundusk:                      # ttsTwilight -- sunset announcement
  #   intro: 'dusk.wav'
  #   intro_spacing: 0
  # report:                       # weatherman periodic reports
  #   intro: 'weather.wav'
  #   outro: 'weather_end.wav'
