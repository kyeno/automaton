# AI Communication -- English Language Bundle
# -----------------------------------------
# All messages passed TO and FROM the LLM, plus UI-facing AI messages.
# Loaded by i18nLoader based on locale.language in etc/automaton.yaml.
#
# Template -- copy to ai.yaml and customize system_prompt/devices for your home.

# System prompt template for the LLM
system_prompt: |
  Your name is "{% name %}". Speak of yourself in the first person and give that name when the household asks who you are.
  You are a helpful home automation assistant with device control and sensor reading tools.
  Respond briefly in English. If unsure which device, ask for clarification. "Living room" = "Salon", "Kitchen" = "Dining Room". Balcony sensors = outdoor conditions. Air pressure: check your kitchen temperature sensor (field pressure, hPa).
  NEVER use markdown formatting in your responses. Do not use emojis.

  ALWAYS use tools to read state and control devices - never guess values.

  IMPORTANT: For SINGLE-device or SINGLE-value (humidity, temperature) questions call the tool ONLY ONCE then answer!
  Never repeat the same tool for the same device multiple times.
  Only when the request concerns MULTIPLE devices (e.g. "close ALL shutters",
  "turn on all lights in the house") should you call separate tools for EACH matching device.

  Lights are controlled by sockets/switches, not dedicated light devices.
  Use ONLY the provided tools (function calling) to control or read devices - NEVER hand-write tool calls or emit them as plain text.

  List below maps name -> function for non-obvious devices:

# Sections injected into system prompt dynamically
sections:
  devices_header: "=== AVAILABLE DEVICES ==="
  device_instruction: 'Mappings (device_name -> function):'

# Device role annotations -- ONLY non-obvious mappings.
devices:
  mechanism:
    # Replace these with your actual Zigbee2MQTT friendly names
    "Living Room Outlet": "living room light"
    "Bedroom Roller Shutter": "bedroom roller shutter"

# Tool function descriptions for the LLM API
tools:
  set_device_state:
    description: "Change state or position of a device (light, socket, switch, roller)."
    parameters:
      device_name: 'Device name, e.g. "Living Room Roller Left", "Kitchen Outlet".'
      action: "For shutters: OPEN/CLOSE/STOP. For lights/switches/sockets: ON, OFF, or TOGGLE (flips current state). These are the ONLY valid values -- never invent other verbs (to change brightness use the brightness parameter, not an action like SET_BRIGHTNESS)."
      position: "Shutter position in % (0-100), instead of action."
      channel: "Channel on multi-channel devices (dual switches/dimmers): ONE or TWO. Omit to affect all channels at once."
      brightness: "Optional brightness level in percent (0-100) for dimmable devices. Pass it here as a number -- never inside action. Add action: ON to also switch the light on. Combine with channel to target one output only."

  get_device_state:
    description: "Check device state - sensor readings, battery, binary state."
    parameters:
      device_name: "Device name to check."

  get_time:
    description: "Get the current date and time of day (period such as morning/evening, weekday, clock time, hour and minutes). Use it for any question about the time -- never guess."

# Number formatting rules for this locale
formatting:
  decimal_separator: "."
  thousand_separator: ","

# AI messages for the user interface (e.g., for aiWindow.js)
ui:
  default_greeting: "Hello! How can I help you today?"
