# WeatherMan -- English Language Bundle
# -------------------------------------
# Speech templates for the ttsWeatherMan automation.
# Supports {{ DeviceName.property }} interpolation for live sensor data.
#
# Template -- copy to weatherman.yaml and customize sentences for your home.

# Opening time-of-day line -- rendered before the base sentence by buildTimeSentence()
# on both output paths. Clock parts are pre-rendered as plain digits.
time_sentence:
  # Generic frame ("It is 32 minutes past 9 in the morning").
  default: 'It is {% minutes %} minutes past {% hours %} {% time_of_day %}.'
  # Exact hour (:00) -- no minutes at all.
  exact_hour: "It is exactly {% hours %} o'clock {% time_of_day %}."
  # Dated frame -- first run of the day/session; the calendar date is fused into the
  # clock sentence via {% date %}.
  dated: 'It is {% date %}, {% minutes %} minutes past {% hours %} {% time_of_day %}.'
  dated_exact_hour: "It is {% date %}, exactly {% hours %} o'clock {% time_of_day %}."
  # Reserved future fractions, auto-selected when defined here: half_past :30, quarter_to :45, quarter_past :15.

# Day-period words ({% time_of_day %}) and duration units ({% next_interval %}) live in
# the per-locale date.yaml bundle.

base: 'The outside temperature is {{ Outdoor Temperature.temperature }} degrees Celsius, humidity is at {{ Outdoor Temperature.humidity }} percent, and atmospheric pressure is {{ Kitchen Temperature.pressure }} hectopascals.'
ai_prefix: 'You are a weather announcer. Rewrite the following information creatively and uniquely. Do not use tools -- base your answer only on the provided information. Do not say that this is the last update if you receive information about the next update. Do not use the word "forecast", only "report". Finally - before announcing when the next update comes - toss in a short anecdote about what you once pulled off in such weather while completely drunk. Here is the information: '

# AI prompt markers -- injected around the message when routing through AI.
# first/last mark the opening/closing update of each daily session (the stretch between
# two silence windows); only marks sessions shorter than the timer interval.
ai_message_first: 'This is the first update of today.'
ai_message_last: 'This is the last update of tonight. The next update is tomorrow.'
ai_message_only: 'This is the only update of today.'
ai_message_next: 'Next update in {% next_interval %}.'

# Closing proverb -- added when add_proverb: true in etc/automation/tts-weatherman.yaml.
# {% proverb %} is filled with a random line from etc/i18n/<locale>/proverbs.txt.
# Placement: after the report body, BEFORE the next-update closer, so the next-update
# time stays last. See Weatherman Speech Rendering -> Segment Order.
# ai_proverb makes no positional claim -- the prompt's line order already places it;
# tts_proverb is the spoken wording for the direct-TTS path.
ai_proverb: 'Remind your listeners of this proverb: {% proverb %}'
tts_proverb: 'And remember: {% proverb %}'

# Posted in the chat window when the AI leg fails or returns nothing -- explains why no
# rewritten report appears before the raw message is spoken instead.
ai_fallback_notice: 'The assistant did not answer in time -- reading the plain report instead.'

warning_hot_day: 'WARNING: It is hot outside. Avoid prolonged exposure.'
warning_humid_stay_at_home: 'WARNING: The air is so thick you can barely breathe! Stay indoors!'
warning_hot_stay_at_home: 'WARNING: It is so hot that breathing is difficult! Make sure to stay indoors!'
warning_apocalypse: 'WARNING: Thermal apocalypse outside! Close blinds, seal windows, crank up the AC, and do not leave the house under any circumstances!'
warning_humid_night: 'WARNING: Humidity levels are too high for comfortable breathing outdoors.'
warning_chill_night: 'Grab a sweater or light jacket before heading out.'
warning_cool_night: 'Before heading out for a walk, put on a sweater, a warm hoodie, a quilted jacket, or a coat.'
warning_cold_night: 'When going outside, put on a hoodie, a jacket, and thicker trousers.'

soothing_warm_day: 'The weather is perfect! Ideal for a walk or working outside!'
soothing_warm_evening: 'What a beautiful evening out there -- perfect for a refreshing walk!'
soothing_warm_night: 'Beautiful night out there. You could step outside in shorts and a t-shirt to enjoy the stars.'
