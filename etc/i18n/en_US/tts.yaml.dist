# TTS Configuration -- English Locale
# ------------------------------------
# Template merged into every TTS API request for this locale.
# "model" is REQUIRED. All other fields are OPTIONAL.
#
# Template -- copy to tts.yaml and customize voice model for your setup.

# REQUIRED - Voice model identifier for tts-server
#model: "en_GB-alan-medium"     # British
model: "en_US-ryan-high"

# OPTIONAL - Uncomment and configure as needed for your voice model
# triple_leading_consonant: false
piper_effects: "--length_scale 1.15 --noise_scale 0.667"
sox_effects: "pad 0.5 0.3"

# OPTIONAL - Override output_endpoint per-request via event payload instead
# If not set here or in the event, falls back to TTS_TCP_ENDPOINT in .env
# output_endpoint: "0.0.0.0:12345"

# ---------------------------------------------------------------------
# OPTIONAL - Named framing profiles: intro/outro waves for a class of speech,
# referenced by name from a speaker's `tts_profile:` (the weatherman/greeter/
# gardener automation YAML, alerts.<family>_tts_profile, ui.tts_profile).
# Profiles carry framing ONLY -- never add output_endpoint here; the audio sink
# stays runtime event > this file > TTS_TCP_ENDPOINT (.env).
# Un-comment and point at wave files that exist on the TTS server (the waveset
# manifest lives in doc/installation/tts-integration.md).
# ---------------------------------------------------------------------
profiles:
  # alarm:                        # mission-critical offline alerts
  #   intro: 'alarm.wav'
  #   intro_spacing: -1.5
  # greeting:                     # greeter + gardener reports
  #   intro: 'hello.wav'
  #   outro: 'bye.wav'
  # sundawn:                      # ttsTwilight -- civil dawn announcement
  #   intro: 'dawn.wav'
  #   intro_spacing: 0
  # sundusk:                      # ttsTwilight -- civil dusk announcement
  #   intro: 'dusk.wav'
  #   intro_spacing: 0
  # report:                       # weatherman periodic reports
  #   intro: 'weather.wav'
  #   outro: 'weather_end.wav'
