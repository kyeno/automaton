# Twilight -- English Language Bundle
# ----------------------------------
# Speech templates for the ttsTwilight automation (dawn / dusk announcements).
# Each section holds per-output-path lines like the greeter and gardener bundles:
#   <section>.tts -- spoken verbatim when use_ai is off / AI unavailable
#   <section>.ai  -- instruction sent to the model; it speaks its own announcement
# Placeholders (filled from the EVENT instant, never the running clock):
#   {% time %}        -- event clock time, zero-padded 24-hour "HH:MM"
#   {% time_of_day %} -- day-period word from date.yaml
#   {% hours %}       -- event hour in the locale's time_format (12h or 24h)
#   {% minutes %}     -- event minutes, unpadded
# English clock time reads naturally in digits, so the tts line uses digits and the ai line
# asks for the hour in words. Announcements use household wording -- "the calendar sundawn /
# sundusk of today", never "civil dawn" / "sunset".
#
# Template -- copy to twilight.yaml and customize the sentences. Section names must match the
# rules[].sentence keys of etc/automation/tts-twilight.yaml.

sundawn:
  tts: "Good morning. It's sunrise now, {% time %} {% time_of_day %} -- the calendar sundawn of today. It's gonna get bright soon."
  ai: "Say in your own words that dawn has come, that it is {% hours %} {% minutes %} {% time_of_day %}, that the sun has just risen, that it's gonna get bright soon, and that you will start the daytime home automations shortly. Say the hour in words, never digits. Do not use tools -- base your announcement only on the information given."

sundusk:
  tts: "It's sunset, {% time %} {% time_of_day %} -- the calendar sundusk of today. It's gonna darken soon."
  ai: "Say in your own words that dusk has come, that it is {% hours %} {% minutes %} {% time_of_day %}, that the sun has just set, that it's gonna darken soon, and that you will start the evening home automations shortly. Say the hour in words, never digits. Do not use tools -- base your announcement only on the information given."
