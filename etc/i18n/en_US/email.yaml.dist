# Email -- English Language Bundle
# -----------------------------------
# Templates for the notification mails the automaton sends to the house owners.
# One section per notification kind, named exactly like the kind the sender passes
# (the gardener's stuck-probe watchdog sends kind 'gardener_stuck'):
#   subject   -- subject line; the email.subject_prefix from automaton.yaml is prepended
#   greeting  -- opening line, addressed to the owner receiving this copy
#   signature -- closing block; the "--" line is the conventional mail signature marker
#   body      -- full body used when the sender has no announcement text of its own
#                (only the 'test' section needs it)
# Placeholders filled by the mail service on every send:
#   {% owner_name %}   -- the owner's name from house_owners
#   {% owner_email %}  -- the owner's address
#   {% bot_name %}     -- the assistant's name (ai.name), "Automaton" when unset
#   {% short_commit_sha %} -- Git revision of the running checkout
#   {% hostname %}     -- machine the automaton runs on
#   {% date %}         -- local calendar day, "YYYY-MM-DD"
#   {% time %}         -- local clock time, "HH:MM"
# Kind-specific placeholders are listed in the gardener bundle (stuck_flowers, stuck_window).
# A placeholder the sender cannot answer is removed from the mail, never left in it.
# Template copy ships as email.yaml.dist.

# Legacy gardener notification kind; current monitor sends sensor_frozen.
gardener_stuck:
  subject: 'Soil probe stuck: {% stuck_flowers %}'
  greeting: 'Hello, {% owner_name %},'
  signature: "-- \n{% bot_name %},\nAutomaton {% short_commit_sha %}"

sensor_frozen:
  subject: 'Frozen sensor warning: {% frozen_sensors %}'
  greeting: 'Hello, {% owner_name %},'
  signature: "-- \n{% bot_name %},\nAutomaton {% short_commit_sha %}"

test:
  subject: 'Automaton email channel test'
  greeting: 'Hello, {% owner_name %},'
  body: 'This is a test of the automaton email channel. Receiving it means the SMTP relay, the sender address and the house owners list are all configured correctly -- no action needed, just delete this message.'
  signature: "-- \n{% bot_name %},\nAutomaton {% short_commit_sha %}"
