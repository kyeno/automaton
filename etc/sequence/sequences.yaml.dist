# AUTOMATON -- Sequences Configuration
# Ordered device choreography with optional loops. Full reference: doc/configuration.md.
# Template -- copy to sequences.yaml and customize for your home.
#
# Entry fields:
#   name      friendly name; slugified internally ('Hazard Lights' -> hazard_lights)
#   delay  optional inter-step pause ("500ms", "2s", ms); absent = steps fire back-to-back
#   devices   simple form: ordered names (or {device, command, delay}); ON/OFF drives each device
#   on/off    rich form: explicit step lists of {device, payload?, delay?}; payload goes to
#             DeviceBase.receiveCommand() verbatim; 'off' defaults to OFF over the 'on' devices
#             A step may instead be {kind: host_command, target, action?, delay?} -- it sends an
#             MQTT host shutdown command (see host_commands in etc/automaton.yaml) and waits for
#             that host's correlated ACK. Put it LAST: it blocks up to ack_timeout, and a lost ACK
#             must never queue the device steps behind it. doc/services/host-commands.md
#   loop      optional looping block:
#             enabled: true
#             cycle: once | continuous        # once = single ON->OFF pass; continuous = repeat
#             off_delay: auto | duration   # gap between the ON run and the OFF run
#             on_delay: auto | duration    # gap between the OFF run and the next ON run
sequences:
  # Simple form + pacing: ambient lights come up one after another.
  - name: 'Ambient Lights'
    delay: '500ms'
    devices:
      - 'Living Room Ambient Left'
      - 'Bedroom Ambient'
      - device: 'Kitchen LED Strip'   # object entries allow per-step overrides
        command: 'ON'
        delay: '800ms'

  # Rich form: Living Room dual-dimmer hazard light oscillation. Brightness values create the
  # transition on the wire -- no extra "transition" field needed.
  - name: 'Hazard Lights'
    loop:
      enabled: true
      cycle: continuous
      off_delay: '2s'   # dwell before the OFF swing
      on_delay: '2s'    # dwell before the next ON swing
    on:                               # phase A -- low values
      - device: 'Living Room Dimmer'
        payload: { state: 'ON', brightness: { l1: 1, l2: 25 } }
    off:                              # phase B -- high values (the swing back)
      - device: 'Living Room Dimmer'
        payload: { state: 'ON', brightness: { l1: 100, l2: 75 } }

  # Rich form with a host step: switch the AV off with IR, then ask the media PC to shut
  #  itself down over MQTT. The host step is LAST on purpose -- it waits up to ack_timeout
  #  (3s by default) for the host's correlated ACK, and the IR sends must not queue behind it.
  #  Needs host_commands.enabled: true and the target's secret_env set in the environment.
  #  An ACK proves the command was accepted, never that the machine is off; presence comes
  #  from etc/device/network.yaml. There is no IR fallback on timeout by design.
  #- name: 'Media Room'
  #  delay: '700ms'
  #  on:
  #    - device: 'Living Room Pilot IR'
  #      payload: { ir_command: avr_on }
  #  off:
  #    - device: 'Living Room Pilot IR'
  #      payload: { ir_command: avr_off }
  #    - kind: 'host_command'
  #      target: 'htpc'
  #      action: 'shutdown'

  # Double-step volume for LANFLIX. Enable mqtt_control.commands.sequence: [run]
  # (or add run to the existing list) and set the transmitter to your IR device.
  # Run avr_volume ON for up or OFF for down.
  #- name: 'AVR Volume'
  #  delay: '375ms'
  #  on:
  #    - device: 'Living Room Pilot IR'
  #      payload: { ir_command: avr_vol_up }
  #    - device: 'Living Room Pilot IR'
  #      payload: { ir_command: avr_vol_up }
  #  off:
  #    - device: 'Living Room Pilot IR'
  #      payload: { ir_command: avr_vol_down }
  #    - device: 'Living Room Pilot IR'
  #      payload: { ir_command: avr_vol_down }
