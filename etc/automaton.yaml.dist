# ================================================================
# AUTOMATON -- Main Configuration File (distribution template)
# ================================================================
# Copy this file to "automaton.yaml" and customize for your environment;
# the system falls back to this .dist file if the active config is missing.
# Behavioral settings live here; connection strings & secrets stay in .env
# (MQTT_URL, REDIS_URL, AI_API_URL, ...). Full reference: doc/configuration.md.
# ================================================================

# ----------------------------------------------------------------
# LOCALE -- language + time display (drives AI prompt, TTS voice, UI greetings)
# ----------------------------------------------------------------
locale:
  # BCP 47 code == directory name under etc/i18n/. Available: pl_PL, en_US
  language: en_US
  # Time display format: "12h" (01:30pm) or "24h" (13:30)
  time_format: "24h"

# ----------------------------------------------------------------
# AI -- provider + conversation settings (API secret stays in .env)
# ----------------------------------------------------------------
ai:
  model: gemma-4-E2B-it      # required for chat requests
  max_tokens: -1            # -1 = omit from request, let the provider default apply
  temperature: 1.0          # sampling 0.0-1.0 (lower=deterministic, higher=creative)
  fetch_timeout_ms: "5m"    # LLM request timeout ("45s","5m","1h") or plain ms; keep generous for local models
  conversation_ttl_sec: "15m"   # how long idle conversations linger in Redis before purge
  max_conversation_turns: 15    # message turns retained in context window
  strip_ai_formatting: false    # strip markdown/emoji before UI/TTS
  stupid_ai_engine: true        # simplify prompts for weak models; set false only with a capable model
  include_chat_history_in_system_calls: false  # system-origin announcements receive prior chat context; default false keeps them standalone (faster inference)

# ----------------------------------------------------------------
# LOGGER -- Winston console/file transports & log file paths
# ----------------------------------------------------------------
logger:
  file:
    max_size: 5242880       # bytes per log file (5MB)
    max_files: 8            # rotated files kept
    tailable: true
  console:
    console_warn_levels: [warn]
    stderr_levels: [error]
  path:                     # relative to project root
    debug: var/log/debug.log
    warn: var/log/warn.log
    trace: var/log/trace.log  # TRACE-level diagnostics only; never shown in UI/console

# Override config/directory locations (optional). Defaults are the etc/* paths below.
# Uncomment and edit to relocate any of them.
# paths:
#   configs:
#     network: "etc/device/network.yaml"
#     interaction: "etc/interaction/interaction.yaml"
#   directories:
#     automation: "etc/automation/"
#     interaction: "etc/interaction/"

# ----------------------------------------------------------------
# AUTOMATION -- global device/interaction behavior
# ----------------------------------------------------------------
automation:
  # Skip a device this long after a human changes it manually ("90s","15m", or ms; 0 = off)
  human_interaction_cooldown_ms: "15m"
  # Optional origin-classification tuning (uncomment to override built-in defaults):
  # echo_window_instant_ms: "15s"    # token TTL for ON/OFF/TOGGLE commands
  # echo_window_travel_ms: "90s"     # token TTL for OPEN/CLOSE/POS:N/STOP travel
  # motion_stall_timeout_ms: "20s"   # no-progress window before assuming external stop
  # settle_absorb_window_ms: "10s"   # post-completion motor-status churn absorption
  # travel_echo_grace_ms: "2s"       # pre-motion near-target grace window
  # failed_command_backoff_ms: "10m" # retry backoff after an unresponsive command

# ----------------------------------------------------------------
# UI -- terminal interface. See doc/ui/index.md for widget/channel reference.
# ----------------------------------------------------------------
ui:
  status_bar:
    lines:
      # Line 1 -- time + time-of-day (left); activity indicator follows the left side
      - left:
          - type: time
            render_seconds: false
          - type: separator
            char: " |"
          - type: time_of_day
        right: []
      # Line 2 -- sensor readings (left), connection status (right)
      - left:
          - type: temp
            device: "Living Room Temperature"
            label: "Living Room"
            format: "{value}*C"
          - type: separator
            char: " |"
          - type: temp
            device: "Bedroom Temperature"
            label: "Bedroom"
            format: "{value}*C"
        right:
          - [{type: state, key: "mqtt.connected", iconTrue: "[o]", iconFalse: "[x]", label: "MQTT"}]
          - [{type: state, key: "redis.connected", iconTrue: "[o]", iconFalse: "[x]", label: "Redis"}]

  layout:
    min_width: 60           # below this terminal width the UI shows a resize warning instead of rendering

  window_settings:
    max_buffer_lines: 2000  # per-window buffer cap (warning: >5000 raises memory/crash risk)

  windows:                  # IRC-style channels; ! = read-only, # = interactive
    - id: logs
      channel: "!log"
      title: "Logs"
      shortcut: 1
      readonly: true
    - id: device
      channel: "!sensors"
      title: "Devices"
      shortcut: 2
      readonly: true
    - id: ai
      channel: "#automaton"
      title: "AI Chat"
      shortcut: 3
      readonly: false
