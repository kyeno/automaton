# AUTOMATON -- Main Configuration File
# Behavioral settings live here; connection strings & secrets stay in .env
# (MQTT_URL, REDIS_URL, AI_API_URL, ...). Full reference: doc/configuration.md
# Template -- copy to automaton.yaml and customize for your setup.

# --- LOCALE: language + time display (drives AI prompt, TTS voice, UI greetings)
locale:
  # BCP 47 code == directory name under etc/i18n/. Available: pl_PL, en_US
  language: en_US
  # Time display format: "12h" (01:30pm) or "24h" (13:30)
  time_format: "24h"
  # Observer coordinates for the sun shorthands ("sundawn"/"sundusk"): WGS84 decimal degrees
  geo_latitude: 52.0
  geo_longitude: 21.0

# --- AI: provider + conversation settings (API secret stays in .env)
ai:
  model: gemma-4-E2B-it      # required for chat requests
  name: Gerwazy           # the assistant's own name: fills {% name %} in the system prompt
  max_tokens: -1            # -1 = omit from request, let the provider default apply
  temperature: 1.0          # sampling 0.0-1.0 (lower=deterministic, higher=creative)
  fetch_timeout_ms: "5m"    # LLM request timeout ("45s","5m","1h") or plain ms; keep generous for local models
  conversation_ttl_sec: "15m"   # how long idle conversations linger in Redis before purge
  max_conversation_turns: 10    # message turns retained in context window
  strip_ai_formatting: true     # strip markdown/emoji before UI/TTS
  include_chat_history_in_system_calls: false  # give system-origin announcements prior chat context

# --- AI BRIDGE: MQTT channel for external clients (web UI / STT backends) to use the AI conversation
ai_bridge:
  enabled: true               # master switch
  topic_base: "automaton/ai"  # MQTT topic tree, outside zigbee2mqtt/*
  forward_events: true        # stream tool/device interactions over MQTT too

# --- ALERTS: spoken notifications for notable system events
# Reference: doc/monitors/offline-alerts.md
alerts:
  # --- Zigbee devices leaving the mesh: spoken warning
  zigbee_offline_tts: true
  # Per-device re-warning cooldown ("90s","15m", or ms); 0 = warn on every leave event
  zigbee_offline_cooldown_ms: "30m"
  # Device names never announced (e.g., intentionally removed sensors)
  zigbee_offline_ignore: []
  # Jingle profile from the locale tts.yaml `profiles:` (empty = none); explicit
  # tts_options below win key by key. Sentences: etc/i18n/<locale>/alerts.yaml.
  # zigbee_offline_tts_options:
  #   intro: 'alarm.wav'
  #   outro: 'end.wav'
  #   intro_spacing: -1.5
  zigbee_offline_tts_profile: ''

  # --- Mission-critical network hosts going offline. Names must exist in
  # etc/device/network.yaml (IPs live there).
  network_offline_tts: true
  network_offline_cooldown_ms: "30m"
  network_offline_ignore: []
  network_offline_tts_profile: ''
  # Announce hosts NetworkPresence already found down at startup
  network_offline_announce_boot: true
  # Speak the recovery sentence when a watched host comes back
  network_offline_announce_recovery: false
  # Watched hosts; per-host overrides optional (null = defaults), accepting
  # cooldown_ms, tts_profile and a tts_options block:
  # network_offline_devices:
  #   core-server:
  #   dns-server:
  #     cooldown_ms: "5m"
  #   wifi-router:
  #     tts_profile: 'alarm'

# --- LOGGER: Winston console/file transports & log file paths
logger:
  file:
    max_size: 5242880       # bytes per log file (5MB)
    max_files: 8            # rotated files kept
    tailable: true
  console:
    console_warn_levels: [warn]
    stderr_levels: [error]
  path:                     # relative to project root
    debug: var/log/debug.log
    warn: var/log/warn.log
    trace: var/log/trace.log  # TRACE-level diagnostics only; never shown in UI/console

# --- PATHS: config/directory locations (optional; defaults are the paths below)
# paths:
#   configs:
#     network: "etc/device/network.yaml"
#     interaction: "etc/interaction/interaction.yaml"
#     sequence: "etc/sequence/sequences.yaml"
#   directories:
#     automation: "etc/automation/"
#     interaction: "etc/interaction/"

# --- AUTOMATION: global device/interaction behavior
automation:
  # Skip a device this long after a human changes it manually ("90s","15m", or ms; 0 = off)
  human_interaction_cooldown_ms: "25m"
  # Optional origin-classification tuning (uncomment to override built-in defaults):
  # echo_window_instant_ms: "15s"    # token TTL for ON/OFF/TOGGLE commands
  # echo_window_travel_ms: "90s"     # token TTL for OPEN/CLOSE/POS:N/STOP travel
  # motion_stall_timeout_ms: "20s"   # no-progress window before assuming external stop
  # settle_absorb_window_ms: "10s"   # post-completion motor-status churn absorption
  # travel_echo_grace_ms: "2s"       # pre-motion near-target grace window
  # failed_command_backoff_ms: "10m" # retry backoff after an unresponsive command

# --- UI: terminal interface. See doc/ui/index.md for widget/channel reference.
ui:
  # Jingle profile for text typed into the TTS window; a name from the locale
  # tts.yaml `profiles:`; empty = plain speech
  tts_profile: ''
  status_bar:
    lines:
      # Line 1 -- time + time-of-day
      - left:
          - type: time
            render_seconds: false
          - type: separator
            char: " |"
          - type: time_of_day
        right: []
      # Line 2 -- sensor readings (left), connection status (right)
      - left:
          - type: temp
            device: "Living Room Temperature"
            label: "Living Room"
            format: "{value}*C"
          - type: separator
            char: " |"
          - type: temp
            device: "Bedroom Temperature"
            label: "Bedroom"
            format: "{value}*C"
        right:
          - [{type: state, key: "mqtt.connected", iconTrue: "[o]", iconFalse: "[x]", label: "MQTT"}]
          - [{type: state, key: "redis.connected", iconTrue: "[o]", iconFalse: "[x]", label: "Redis"}]

  layout:
    min_width: 74           # below this terminal width the UI shows a resize warning instead of rendering

  window_settings:
    max_buffer_lines: 2000  # per-window buffer cap (warning: >5000 raises memory/crash risk)

  windows:                  # IRC-style channels; ! = read-only, # = interactive
    - id: logs
      channel: "!log"
      title: "Logs"
      shortcut: 1
      readonly: true
    - id: device
      channel: "!sensors"
      title: "Devices"
      shortcut: 2
      readonly: true
    - id: ai
      channel: "#automaton"
      title: "AI Chat"
      shortcut: 3
      readonly: false
    - id: tts
      channel: "#tts"
      title: "TTS"
      shortcut: 4
      readonly: false
    - id: rules
      channel: "!rules"
      title: "Rules"
      shortcut: 5
      readonly: true
