#!/usr/bin/env node
/**
 * Simple test bundle runner.
 * Runs syntax checks on all source files and executes all test scripts.
 *
 * Copyright (C) 2026 Ratan M. Kyeno <matt@prayam.com>
 * Licensed under the GNU Affero General Public License v3.0 (AGPL-3.0-only).
 *
 * @author Ratan M. Kyeno
 * @license AGPL-3.0-only
 */
import { execFileSync, spawnSync } from 'node:child_process'
import { createTestWorkspace, testEnvironment, resetTestConfig } from '../tests/helpers/test-workspace.js'
import { readdirSync } from 'node:fs'
import { join, resolve } from 'node:path'

const ROOT = resolve(import.meta.dirname, '..')
const SRC_DIR = join(ROOT, 'src')
const TESTS_DIR = join(ROOT, 'tests')

// Run current source in a disposable checkout, with no active deployment files or .env.
if (process.env.AUTOMATON_TEST_WORKSPACE !== '1') {
    const workspace = createTestWorkspace(ROOT)
    let status = 1
    try {
        const result = spawnSync(process.execPath, [join(workspace.root, 'bin', 'automaton-test'), ...process.argv.slice(2)], {
            cwd: workspace.root, env: testEnvironment(workspace.root), stdio: 'inherit',
        })
        if (result.error) throw result.error
        status = result.status ?? 1
    } finally { workspace.cleanup() }
    process.exit(status)
}


let failures = 0
let passed = 0

/* ------------------------------------------------------------------ */
 /* Helper                                                             */
/* ------------------------------------------------------------------ */
function run(args, label) {
  process.stdout.write(`  ▶ ${label} ... `)
  try {
    execFileSync(process.execPath, args, {
      stdio: ['ignore', 'pipe', 'pipe'], cwd: ROOT, timeout: 60_000, maxBuffer: 8 * 1024 * 1024,
    })
    console.log('✓')
    passed++
  } catch (e) {
    console.error('✗')
    console.error(`      ${e.message}`)
    if (e.stdout) process.stderr.write(e.stdout.toString())
    if (e.stderr) process.stderr.write(e.stderr.toString())
    failures++
  }
}

/* ------------------------------------------------------------------ */
 /* 1. Syntax-check every .js file under src/                          */
/* ------------------------------------------------------------------ */
console.log('\n── Syntax checks ──\n')

function collectJs(dir, list = [], fs) {
  for (const entry of readdirSync(dir)) {
    const full = join(dir, entry)
    // skip node_modules and var-like dirs
    if (entry.startsWith('.')) continue
    const stat = fs.statSync(full)
    if (stat.isDirectory()) {
      collectJs(full, list, fs)
    } else if (entry.endsWith('.js')) {
      list.push(full.replace(ROOT + '/', ''))
    }
  }
  return list
}

const fs = await import('node:fs')

// Also scan etc/ for custom automation/interaction scripts (.js only, not .js.dist)
const ETC_DIRS = ['etc/automation', 'etc/interaction']
for (const dir of ETC_DIRS) {
  const fullDir = join(ROOT, dir)
  try {
    fs.accessSync(fullDir)
  } catch {
    continue // directory may not exist in minimal setups
  }
  const etcFiles = collectJs(fullDir, [], fs)
  for (const f of etcFiles) {
    if (f.endsWith('.js.dist')) continue // skip distribution templates
    run(['--check', join(ROOT, f)], `syntax ${f}`)
  }
}

const files = collectJs(SRC_DIR, [], fs)
for (const f of files) {
  run(['--check', join(ROOT, f)], `syntax ${f}`)
}

/* ------------------------------------------------------------------ */
 /* 2. Run non-sound test scripts                                      */
/* ------------------------------------------------------------------ */
console.log('\n── Test scripts ──\n')

const defaultTestScripts = [
  'test-test-workspace.js',
  'test-config-validation.js',
  'test-config-migration.js',
  'test-config-overrides.js',
  'test-config-cmd.js',
  'test-config-reload.js',

  'test-device-instantiation.js',
  'test-device-classification.js',
  'test-dualswitch.js',
  'test-automation-instantiation.js',
  'test-automation-ai-guard.js',
  'test-automation-cmd.js',
  'test-rule-coverage.js',
  'test-hour-condition.js',
  'test-sun-gate-condition.js',
  'test-roller-morning-darkness.js',
  'test-night-window-restore.js',
  'test-composite-conditions.js',
  'test-legacy-condition-keys.js',
  'test-interaction-cmd.js',
  'test-roller-shutters.js',
  'test-kitchen-countertop-led.js',
  'test-sequences.js',
  'test-device-cmd.js',
  'test-silence-between.js',
  'test-weatherman-day-position.js',
  'test-weatherman-time-phrase.js',
  'test-weatherman-ai-fallback.js',
  'test-weatherman-video-suppression.js',
  'test-weatherman-proverb.js',
  'test-date-helper.js',
  'test-polish-words.js',
  'test-random-line.js',
  'test-tts-options-passthrough.js',
  'test-tts-profiles.js',
  'test-ambient-lights-rules.js',
  'test-home-theater-rules.js',
  'test-automation-force.js',
  'test-invoke-automation.js',
  'test-trigger-coalescing.js',
  'test-rule-based-targets.js',
  'test-video-player-host-resolution.js',
  'test-video-player-suppression.js',
  'test-video-player-settle.js',
  'test-database-service.js',
  'test-sensor-history.js',
  'test-daylight-learning.js',
  'test-rule-react-on-change.js',
  'test-tts-greeter.js',
  'test-tts-gardener.js',
  'test-frozen-sensor-monitor.js',
  'test-tts-twilight.js',
  'test-email-service.js',
  'test-service-instantiation.js',
  'test-origin-classification.js',
  'test-mqtt-publish-hook.js',
  'test-mqtt-reconnect.js',
  'test-cache-outage.js',
  'test-mqtt-dedupe-exempt.js',
  'test-mqtt-soil-moisture-dedupe.js',
  'test-command-reassert.js',
  'test-ai-intent-parsing.js',
  'test-ai-intent-execution.js',
  'test-ai-conversation-isolation.js',
  'test-ai-assistant-name.js',
  'test-ai-device-offline.js',
  'test-provider-timeout.js',
  'test-string-utils.js',
  'test-timed-action.js',
  'test-input-component.js',
  'test-command-completer.js',
  'test-terminal-wrap.js',
  'test-log-window-buffer.js',
  'test-window-preformatted.js',
  'test-rules-window.js',
  'test-rules-cmd.js',
  'test-rule-match-history.js',
  'test-device-window-header.js',
  'test-device-window-sensor-columns.js',
  'test-device-window-table.js',
  'test-ui-min-width.js',
  // Note: JSDoc coverage + completeness checks live in npm run lint:check
  'test-sound.js',
  'test-sound-mario.js',
  'test-get-time-tool.js',
  'test-ai-bridge-monitor.js',
  'test-zigbee-device-offline-monitor.js',
  'test-network-device-offline-monitor.js',
  'test-weatherman-use-ai-flag.js',
]

const requested = process.argv.slice(2)
const testScripts = requested.length ? requested.map((name) => name.replace(/^tests\//, '')) : defaultTestScripts
for (const script of testScripts) {
  if (!/^test-[a-z0-9-]+\.js$/.test(script)) throw new Error(`Invalid test filename: ${script}`)
  const path = join(TESTS_DIR, script)
  // A missing test is an error, never a silent loss of coverage.
  try {
    fs.accessSync(path)
  } catch {
    console.error(`  ✗ ${script} (not found)`)
    failures++
    continue
  }
  resetTestConfig(ROOT)
  run([path], script)
}

/* ------------------------------------------------------------------ */
 /* Summary                                                            */
/* ------------------------------------------------------------------ */
const total = passed + failures
console.log(
  `\n${'═'.repeat(50)}` +
  `\n  Results: ${passed}/${total} passed` +
  (failures > 0 ? `, ${failures} failed` : '') +
  `\n${'═'.repeat(50)}\n`
)

process.exit(failures > 0 ? 1 : 0)
