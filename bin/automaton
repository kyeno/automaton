#!/bin/bash
printf "\033]0;AUTOMATON\007"
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PROJECT_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"
ORIG_DIR="$(pwd)"
unamestr=$(uname)
if [ "$unamestr" = 'Linux' ]; then
    export $(grep -v '^#' "$PROJECT_DIR/.env" | xargs -d '\n')
elif [ "$unamestr" = 'FreeBSD' ] || [ "$unamestr" = 'Darwin' ]; then
    export $(grep -v '^#' "$PROJECT_DIR/.env" | xargs -0)
fi
cd "$PROJECT_DIR"
npm run start -- $*
exit_code=$?
cd "$ORIG_DIR"
exit $exit_code
