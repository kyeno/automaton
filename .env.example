# Service Connection Strings
MQTT_URL=mqtt://localhost:1883
MQTT_PREFIX=zigbee2mqtt

# Redis Connection
REDIS_URL=redis://YOUR_REDIS_HOST:6379

# AI Provider (OpenAI-compatible API) - secrets only
# Model, max_tokens, temperature are in etc/automaton.yaml
# Disable per-run with the --no-ai CLI flag instead of removing these
AI_API_URL=http://YOUR_LLM_HOST:8080/v1
AI_API_KEY=your-api-key-here

# TTS Provider (tts-server API)
# Disable per-run with the --no-tts CLI flag instead of removing these
TTS_API_URL=http://YOUR_TTS_HOST:7423/tts

# TTS Output Endpoint (TCP address of speaker device)
TTS_TCP_ENDPOINT=YOUR_TTS_HOST:12345

# Email Relay (SMTP server for notification mails to the house owners)
# Behavioral settings (enabled, from, notify, cooldown, subject prefix) are in
# etc/automaton.yaml -- only the relay connection and its credentials live here.
# Disable per-run with the --no-email CLI flag instead of removing these.
SMTP_HOST=smtp.YOUR_MAIL_HOST
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=automaton@YOUR_MAIL_DOMAIN
SMTP_PASS=your-smtp-password-here

# Host Shutdown Secret (shared HMAC-SHA256 key for MQTT host shutdown commands)
# Named by host_commands.targets.<target>.secret_env in etc/automaton.yaml. It must be
# byte-identical to the value on the target host -- on the HTPC:
#   setx HTPC_MQTT_SECRET "<the same value>"
# An unset value leaves that target inert: every request fails closed, nothing is sent.
# Generate one with: openssl rand -hex 32
# Never put this in a YAML file, a command line, a log or a .bat.
HTPC_MQTT_SECRET=replace-with-the-shared-host-shutdown-secret
