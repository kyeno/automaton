# Service Connection Strings
MQTT_URL=mqtt://localhost:1883
MQTT_PREFIX=zigbee2mqtt

# Redis Connection
REDIS_URL=redis://YOUR_REDIS_HOST:6379

# AI Provider (OpenAI-compatible API) - secrets only
# Model, max_tokens, temperature are in etc/automaton.yaml
# Disable per-run with the --no-ai CLI flag instead of removing these
AI_API_URL=http://YOUR_LLM_HOST:8080/v1
AI_API_KEY=your-api-key-here

# TTS Provider (tts-server API)
# Disable per-run with the --no-tts CLI flag instead of removing these
TTS_API_URL=http://YOUR_TTS_HOST:7423/tts

# TTS Output Endpoint (TCP address of speaker device)
TTS_TCP_ENDPOINT=YOUR_TTS_HOST:12345
