# Node.js deps
node_modules/

# Development files
*.code-workspace
*.swp
*.swo
*~
.DS_Store
_debug/

# Generated documentation
doc/api/

# User-specific files
.env
var/log/*.log

# Local SQLite state-transition history store (+ WAL/SHM sidecars), stored under var/db/
/var/db/automaton.db
/var/db/automaton.db-wal
/var/db/automaton.db-shm

# Active config files (tracked .dist templates take precedence)
etc/**/*.yaml
!etc/**/*.yaml.dist
etc/**/*.js
!etc/**/*.js.dist